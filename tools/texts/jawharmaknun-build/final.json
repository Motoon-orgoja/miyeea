[{"a":"اَلْحَمْدُ لِلهِ الْبَدِيعِ الْهَادِي","b":"إِلَى بَيَانِ مَهْيَعِ الرَّشَادِ"},{"a":"أَمَدَّ أَرْبَابَ النُّهَى وَرَسَمَا","b":"شَمْسَ الْبَيَانِ فِي صُدُورِ الْعُلَمَا"},{"a":"فَأَبْصَرُوا مُعْجِزَةَ الْقُرْآنِ","b":"وَاضِحَةً بِسَاطِعِ الْبُرْهَانِ"},{"a":"وَشَاهَدُوا مَطَالِعَ الْأَنْوَارِ","b":"وَمَا احْتَوَتْ عَلَيْهِ مِنْ أَسْرَارِ"},{"a":"فَنَزَّهُوا الْقُلُوبَ فِي رِيَاضِهِ","b":"وَأَوْرَدُوا الْفِكْرَ عَلَى حِيَاضِهِ"},{"a":"ثُمَّ صَلَاةُ اللهِ مَا تَرَنَّمَا","b":"حَادٍ يَسُوقُ الْعِيسَ فِي أَرْضِ الْحِمَى"},{"a":"عَلَى نَبِيِّنَا الْحَبِيبِ الْهَادِي","b":"أَجَلِّ كُلِّ نَاطِقٍ بِالضَّادِ"},{"a":"مُحَمَّدٍ سَيِّدِ خَلْقِ اللهِ","b":"اَلْعَرَبِيِّ الطَّاهِرِ الْأَوَّاهِ"},{"a":"ثُمَّ عَلَى صَاحِبِهِ الصِّدِّيقِ","b":"حَبِيبِهِ وَعُمَرَ الْفَارُوقِ"},{"a":"ثُمَّ أَبِي عَمْرٍو إِمَامِ الْعَابِدِينْ","b":"وَسَطْوَةِ اللهِ إِمَامِ الزَّاهِدِينْ"},{"a":"ثُمَّ عَلَى بَقِيَّةِ الصَّحَابَهْ","b":"ذَوِي التُّقَى وَالْفَضْلِ وَالْإِنَابَهْ"},{"a":"وَالْمَجْدِ وَالْفُرْصَةِ وَالْبَرَاعَهْ","b":"وَالْحَزْمِ وَالنَّجْدَةِ وَالشَّجَاعَهْ"},{"a":"مَا عَكَفَ الْقَلْبُ عَلَى الْقُرْآنِ","b":"مُرْتَقِيًا لِحَضْرَةِ الْعِرْفَانِ"},{"a":"هَذَا وَإِنَّ دُرَرَ الْبَيَانِ","b":"وَغُرَرَ الْبَدِيعِ وَالْمَعَانِي"},{"a":"تَهْدِي إِلَى مَوَارِدٍ شَرِيفَهْ","b":"وَنُبَذٍ بَدِيعَةٍ لَطِيفَهْ"},{"a":"مِنْ عِلْمِ أَسْرَارِ اللِّسَانِ الْعَرَبِي","b":"وَدَرْكِ مَا خُصَّ بِهِ مِنْ عَجَبِ"},{"a":"لِأَنَّهُ كَالرُّوحِ لِلْإِعْرَابِ","b":"وَهْوَ لِعِلْمِ النَّحْوِ كَاللُّبَابِ"},{"a":"وَقَدْ دَعَا بَعْضٌ مِنَ الطُّلَاَّبِ","b":"لِرَجَزٍ يَهْدِي إِلَى الصَّوَابِ"},{"a":"فَجِئْتُهُ بَرَجَزٍ مُفِيدِ","b":"مُهَذَّبٍ مُنَقَّحٍ سَدِيدِ"},{"a":"مُلْتَقِطًا مِنْ دُرَرِ التَّلْخِيصِ","b":"جَوَاهِرًا بَدِيعَةَ التَّخْلِيصِ"},{"a":"سَلَكْتُ مَا أَبْدَى مِنَ التَّرْتِيبِ","b":"وَمَا أَلَوْتُ الْجُهْدَ فِي التَّهْذِيبِ"},{"a":"سَمَّيْتُهُ بِالْجَوْهَرِ الْمَكْنُونِ","b":"فِي صَدَفِ الثَّلَاثَةِ الْفُنُونِ"},{"a":"وَاللهَ أَرْجُو أَنْ يَكُونَ نَافِعَا","b":"لِكُلِّ مَنْ يَقْرَؤُهُ وَرَافِعَا"},{"a":"وَأَنْ يَكُونَ فَاتِحًا لِلْبَابِ","b":"لِجُمْلَةِ الْإِخْوَانِ وَالْأَصْحَابِ"},{"a":"فَصَاحَةُ الْمُفْرَدِ أَنْ يَخْلُصَ مِنْ","b":"تَنَافُرٍ غَرَابَةٍ خُلْفٍ زُكِنْ"},{"a":"وَفِي الْكَلَامِ مِنْ تَنَافُرِ الْكَلِمْ","b":"وَضَعْفِ تَأْلِيفٍ وَتَعْقِيدٍ سَلِمْ"},{"a":"وَذِي الْكَلَامِ صِفَةٌ بِهَا يُطِيقْ","b":"تَأْدِيَةَ الْمَقْصُودِ بِاللَّفْظِ الْأَنِيقْ"},{"a":"وَجَعَلُوا بَلَاغَةَ الْكَلَامِ","b":"طِبَاقَهُ لِمُقْتَضَى الْمَقَامِ"},{"a":"وَحَافِظٌ تَأْدِيَةَ الْمَعَانِي","b":"عَنْ خَطَأٍ يُعْرَفُ بِالْمَعَانِي"},{"a":"وَمَا مِنَ التَّعْقِيدِ فِي الْمَعْنَى يَقِي","b":"لَهُ الْبَيَانُ عِنْدَهُمْ قَدِ انْتُقِي"},{"a":"وَمَا بِهِ وُجُوهُ تَحْسِينِ الْكَلَامْ","b":"تُعْرَفُ يُدْعَى بِالْبَدِيعِ وَالسَّلَامْ"},{"a":"عِلْمٌ بِهِ لِمُقْتَضَى الْحَالِ يُرَى","b":"لَفْظًا مُطَابِقًا وَفِيهِ ذُكِرَا"},{"a":"إِسْنَادُ مُسْنَدٌ إِلَيْهِ مُسْنَدُ","b":"وَمُتَعَلِّقَاتُ فِعْلٍ تُورَدُ"},{"a":"قَصْرٌ وَإِنْشَاءٌ وَفَصْلٌ وَصْلٌ اوْ","b":"إِيجَازٌ اطْنَابٌ مُسَاوَاةٌ رَأَوْا"},{"a":"اَلْحُكْمُ بِالسَّلْبِ أَوِ الْإِيجَابِ","b":"إِسْنَادُهُمْ وَقَصْدُ ذِي الْخِطَابِ"},{"a":"إِفَادَةُ السَّامِعِ نَفْسَ الْحُكْمِ","b":"أَوْ كَوْنَ مُخْبِرٍ بِهِ ذَا عِلْمِ"},{"a":"فَأَوَّلٌ فَائِدَةٌ وَالثَّانِي","b":"لَازِمُهَا عِنْدَ ذَوِي الْأَذْهَانِ"},{"a":"وَرُبَّمَا أُجْرِيَ مُجْرَى الْجَاهِلِ","b":"مُخَاطَبٌ إِنْ كَانَ غَيْرَ عَامِلِ"},{"a":"كَقَوْلِنَا لِعَالِمٍ ذِي غَفْلَةِ","b":"اَلذِّكْرُ مُفْتَاحٌ لِبَابِ الْحَضْرَةِ"},{"a":"فَيَنْبَغِي اقْتِصَارُ ذِي الْإِخْبَارِ","b":"عَلَى الْمُفِيدِ خَشْيَةَ الْإِكْثَارِ"},{"a":"فَيُخْبِرُ الْخَالِي بِلَا تَوْكِيدِ","b":"مَا لَمْ يَكُنْ فِي الْحُكْمِ ذَا تَرْدِيدِ"},{"a":"فَحَسَنٌ وَمُنْكِرُ الْإِخْبَارِ","b":"حَتْمٌ لَهُ بِحَسَبِ الْإِنْكَارِ"},{"a":"كَقَوْلِهِ ﴿إِنَّا إِلَيْكُمْ مُرْسَلُونْ﴾","b":"فَزَادَ بَعْدُ مَا اقْتَضَاهُ الْمُنْكِرُونْ"},{"a":"لِلَفْظِ الِابْتِدَاءِ ثُمَّ الطَّلَبِ","b":"ثُمَّتَ الِانْكَارِ الثَّلَاثَةَ انْسُبِ"},{"a":"وَاسْتَحْسِنِ التَّوْكِيدَ إِنْ لَوَّحْتَ لَهْ","b":"بِخَبَرٍ كَسَائِلٍ فِي الْمَنْزِلَهْ"},{"a":"وَأَلْحَقُوا أَمَارَةَ الْإِنْكَارِ بِهْ","b":"كَعَكْسِهِ لِنُكْتَةٍ لَمْ تَشْتَبِهْ"},{"a":"بِقَسَمٍ قَدْ إِنَّ لَامِ الِابْتِدَا","b":"وَنُونَيِ التَّوْكِيدِ وَاسْمٍ أُكِّدَا"},{"a":"وَالنَّفْيُ كَالْإِثْبَاتِ فِي ذَا الْبَابِ","b":"يَجْرِي عَلَى الثَّلَاثَةِ الْأَلْقَابِ"},{"a":"بِإِنْ وَكَانَ لَامٍ اوْ بَاءٍ يَمِينْ","b":"كَمَا جَلِيسُ الْفَاسِقِينَ بِالْأَمِينْ"},{"a":"وَلِحَقِيقَةٍ مَجَازٍ وَرَدَا","b":"لِلْعَقْلِ مَنْسُوبَيْنِ أَمَّا الْمُبْتَدَا"},{"a":"إِسْنَادُ فِعْلٍ أَوْ مُضَاهِيهِ إِلَى","b":"صَاحِبِهِ كَفَازَ مَنْ تَبَتَّلَا"},{"a":"أَقْسَامُهُ مِنْ حَيْثُ الِاعْتِقَادُ","b":"وَوَاقِعٌ أَرْبَعَةٌ تُفَادُ"},{"a":"وَالثَّانِ أَنْ يُسْنَدَ لِلْمُلَابَسِ","b":"لَيْسَ لَهُ يُبْنَى كَثَوْبٍ لَابِسِ"},{"a":"أَقْسَامُهُ بِحَسَبِ النَّوْعَيْنِ فِي","b":"جُزْأَيْهِ أَرْبَعٌ بِلَا تَكَلُّفِ"},{"a":"وَوَجَبَتْ قَرِينَةٌ لَفْظِيَّهْ","b":"أَوْ مَعْنَوِيَّةٌ وَإِنْ عَادِيَّهْ"},{"a":"يُحْذَفُ لِلْعِلْمِ وَلَاخْتِبَارِ","b":"مُسْتَمِعٍ وَصِحَّةِ الْإِنْكَارِ"},{"a":"سَتْرٍ وَضِيقِ فُرْصَةٍ إِجْلَالِ","b":"وَعَكْسِهِ وَنَظْمٍ اسْتِعْمَالِ"},{"a":"كَحَبَّذَا طَرِيقَةُ الصُّوفِيَّهْ","b":"تَهْدِي إِلَى الْمَرْتَبَةِ الْعَلِيَّهْ"},{"a":"وَاذْكُرْهُ لِلْأَصْلِ وَالِاحْتِيَاطِ","b":"غَبَاوَةٍ إِيضَاحٍ انْبِسَاطِ"},{"a":"تَلَذُّذٍ تَبَرُّكٍ إِعْظَامِ","b":"إِهَانَةٍ تَشَوُّقٍ نِظَامِ"},{"a":"تَعَبُّدٍ تَعَجُّبٍ تَهْوِيلِ","b":"تَقْرِيرٍ اوْ إِشْهَادٍ اوْ تَسْجِيلِ"},{"a":"وَكَوْنُهُ مُعَرَّفًا بِمُضْمَرِ","b":"بِحَسَبِ الْمَقَامِ فِي النَّحْوِ دُرِي"},{"a":"وَالْأَصْلُ فِي الْمُخَاطَبِ التَّعْيِينُ","b":"وَالتَّرْكُ لِلشُّمُولِ مُسْتَبِينُ"},{"a":"وَكَوْنُهُ بِعَلَمٍ لِيَحْصُلَا","b":"بِذِهْنِ سَامِعٍ بِشَخْصٍ أَوَّلَا"},{"a":"تَبَرُّكٍ تَلَذُّذٍ عِنَايَةِ","b":"إِجْلَالٍ اوْ إِهَانَةٍ كِنَايَةِ"},{"a":"وَكَوْنُهُ بِالْوَصْلِ لِلتَّفْخِيمِ","b":"تَقْرِيرٍ اوْ هُجْنَةٍ اوْ تَوْهِيمِ"},{"a":"إِيمَاءٍ اوْ تَوَجُّهِ السَّامِعِ لَهْ","b":"أَوْ فَقْدِ عِلْمِ سَامِعٍ غَيْرَ الصِّلَهْ"},{"a":"وَبِإِشَارَةٍ لِكَشْفِ الْحَالِ","b":"مِنْ قُرْبٍ اوْ بُعْدٍ أَوِ اسْتِجْهَالِ"},{"a":"أَوْ غَايَةِ التَّمْيِيزِ وَالتَّعْظِيمِ","b":"وَالْحَطِّ وَالتَّنْبِيهِ وَالتَّفْخِيمِ"},{"a":"وَكَوْنُهُ بِاللَّامِ فِي النَّحْوِ عُلِمْ","b":"لَكِنَّ الِاسْتِغْرَاقَ فِيهِ يَنْقَسِمْ"},{"a":"إِلَى حَقِيقِيٍّ وَعُرْفِيٍّ وَفِي","b":"فَرْدٍ مِنَ الْجَمْعِ أَعَمُّ فَاقْتَفِي"},{"a":"وَبِإِضَافَةٍ لِحَصْرٍ وَاخْتِصَارْ","b":"تَشْرِيفِ أَوَّلٍ وَثَانٍ وَاحْتِقَارْ"},{"a":"تَكَافُؤٍ سَآمَةٍ إِخْفَاءِ","b":"وَحَثٍّ اوْ مَجَازٍ اسْتِهْزَاءِ"},{"a":"وَنَكَّرُوا إِفْرَادًا اوْ تَكْثِيرَا","b":"تَنْوِيعًا اوْ تَعْظِيمًا اوْ تَحْقِيرَا"},{"a":"كَجَهْلٍ اوْ تَجَاهُلٍ تَهْوِيلِ","b":"تَهْوِينٍ اوْ تَلْبِيسٍ اوْ تَقْلِيلِ"},{"a":"وَوَصْفُهُ لِكَشْفٍ اوْ تَخْصِيصِ","b":"ذَمٍّ ثَنَا تَوْكِيدٍ اوْ تَنْصِيصِ"},{"a":"وَأَكَّدُوا تَقْرِيرًا اوْ قَصْدَ الْخُلُوصْ","b":"مِنْ ظَنِّ سَهْوٍ أَوْ مَجَازٍ أَوْ خُصُوصْ"},{"a":"وَعَطَفُوا عَلَيْهِ بِالْبَيَانِ","b":"بِاسْمٍ بِهِ يَخْتَصُّ لِلْبَيَانِ"},{"a":"وَأَبْدَلُوا تَقْرِيرًا اوْ تَحْصِيلَا","b":"وَعَطَفُوا بِنَسَقٍ تَفْصِيلَا"},{"a":"لِأَحَدِ الْجُزْأَيْنِ أَوْ رَدٍّ إِلَى","b":"حَقٍّ وَصَرْفَ الْحُكْمِ لِلَّذِي تَلَا"},{"a":"وَالشَّكِّ وَالتَّشْكِيكِ وَالْإِبْهَامِ","b":"وَغَيْرِ ذَلِكَ مِنَ الْأَحْكَامِ"},{"a":"وَفَصْلُهُ يُفِيدُ قَصْرَ الْمُسْنَدِ","b":"عَلَيْهِ كَالصُّوفِيُّ هُوَّ الْمُهْتَدِي"},{"a":"وَقَدَّمُوا لِلْأَصْلِ أَوْ تَشْوِيفِ","b":"لِخَبَرٍ تَلَذُّذٍ تَشْرِيفِ"},{"a":"وَحَطٍّ اهْتِمَامٍ اوْ تَنْظِيمِ","b":"تَفَاؤُلٍ تَخْصِيصٍ اوْ تَعْمِيمِ"},{"a":"إِنْ صَاحَبَ الْمُسْنَدَ حَرْفُ السَّلْبِ","b":"إِذْ ذَاكَ يَقْتَضِي عُمُومَ السَّلْبِ"},{"a":"وَخَرَجُوا عَنْ مُقْتَضَى الظَّوَاهِرِ","b":"كَوَضْعِ مُضْمَرٍ مَكَانَ الظَّاهِرِ"},{"a":"لِنُكْتَةٍ كَبَعْثٍ اوْ كَمَالِ","b":"تَمْيِيزٍ اوْ سُخْرِيَةٍ إِجْهَالِ"},{"a":"أَوْ عَكْسٍ اوْ دَعْوَى الظُّهُورِ وَالْمَدَدْ","b":"لِنُكْتَةِ التَّمْكِينِ كَاللهُ الصَّمَدْ"},{"a":"وَقَصْدِ الِاسْتِعْطَافِ وَالْإِرْهَابِ","b":"نَحْوُ الْأَمِيرُ وَاقِفٌ بِالْبَابِ"},{"a":"وَمِنْ خِلَافِ الْمُقْتَضَى صَرْفُ مُرَادْ","b":"ذِي نُطْقٍ اوْ سُؤْلٍ لِغَيْرِ مَا أَرَادْ"},{"a":"لِكَوْنِهِ أَوْلَى بِهِ وَأَجْدَرَا","b":"كَقِصَّةِ الْحَجَّاجِ وَالْقَبَعْثَرَى"},{"a":"وَالِالْتِفَاتُ وَهْوَ الِانْتِقَالُ مِنْ","b":"بَعْضِ الْأَسَالِيبِ إِلَى بَعْضٍ قَمِنْ"},{"a":"وَالْوَجْهُ الِاسْتِجْلَابُ لِلْخِطَابِ","b":"وَنُكْتَةٍ تَخُصُّ بَعْضَ الْبَابِ"},{"a":"وَصِيغَةَ الْمَاضِي لِآتٍ أَوْرَدُوا","b":"وَقَلَبُوا لِنُكْتَةٍ وَأَنْشَدُوا"},{"a":"وَمَهْمَهٍ مُغْبَرَّةٍ أَرْجَاؤُهُ","b":"كَأَنَّ لَوْنَ أَرْضِهِ سَمَاؤُهُ"},{"a":"يُحْذَفُ مُسْنَدٌ لِمَا تَقَدَّمَا","b":"وَالْتَزَمُوا قَرِينَةً لِيُعْلَمَا"},{"a":"وَذِكْرُهُ لِمَا مَضَى أَوْ لِيُرَى","b":"فِعْلًا أَوِ اسْمًا فَيُفِيدَ الْمُخْبَرَا"},{"a":"وَأَفْرَدُوهُ لِانْعِدَامِ التَّقْوِيَهْ","b":"وَسَبَبٍ كَالزُّهْدُ رَأْسُ التَّزْكِيَهْ"},{"a":"وَكَوْنُهُ فِعْلًا فَلِلتَّقْيِيدِ","b":"بِالْوَقْتِ مَعْ إِفَادَةِ التَّجْدِيدِ"},{"a":"وَكَوْنُهُ اسْمًا لِلْثُبُوتِ وَالدَّوَامْ","b":"وَقَيَّدُوا كَالْفِعْلِ رَعْيًا لِلتَّمَامْ"},{"a":"وَتَرَكُوا تَقْيِيدَهُ لِنُكْتَةٍ","b":"كَسُتْرَةٍ أَوِ انْتِهَازِ فُرْصَةٍ"},{"a":"وَخَصَّصُوا بِالْوَصْفِ وَالْإِضَافَهْ","b":"وَتَرَكُوا لِمُقْتَضٍ خِلَافَهْ"},{"a":"وَكَوْنُهُ مُعَلَّقًا بِالشَّرْطِ","b":"فَلِمَعَانِي أَدَوَاتِ الشَّرْطِ"},{"a":"وَنَكَّرُوا إِتْبَاعًا اوْ تَفْخِيمَا","b":"حَطًّا وَفَقْدَ عَهْدٍ اوْ تَعْمِيمَا"},{"a":"وَعَرَّفُوا إِفَادَةً لِلْعِلْمِ","b":"بِنِسْبَةٍ أَوْ لَازِمٍ لِلْحُكْمِ"},{"a":"وَقَصَرُوا تَحْقِيقًا اوْ مُبَالَغَهْ","b":"بِعُرْفِ جِنْسِهِ كَهِنْدُ الْبَالِغَهْ"},{"a":"وَجُمْلَةً لِسَبَبٍ أَوْ تَقْوِيَهْ","b":"كَالذِّكْرُ يَهْدِي لِطَرِيقِ التَّصْفِيَهْ"},{"a":"وَاسْمِيَّةُ الْجُمْلَةِ وَالْفِعْلِيَّهْ","b":"وَشَرْطُهَا لِلنُّكْتَةِ الْجَلِيَّهْ"},{"a":"وَأَخَّرُوا أَصَالَةً وَقَدَّمُوا","b":"لِقَصْرِ مَا بِهِ عَلَيْهِ يُحْكَمُ"},{"a":"تَنْبِيهٍ اوْ تَفَاؤُلٍ تَشَوُّفِ","b":"كَفَازَ بِالْحَضْرَةِ ذُو تَصَوُّفِ"},{"a":"وَالْفِعْلُ مَعْ مَفْعُولِهِ كَالْفِعْلِ مَعْ","b":"فَاعِلِهِ فِيمَا لَهُ مَعْهُ اجْتَمَعْ"},{"a":"وَالْغَرَضُ الْإِشْعَارُ بِالتَّلَبُّسِ","b":"بِوَاحِدٍ مِنْ صَاحِبَيْهِ فَائْتَسِ"},{"a":"وَغَيْرُ قَاصِرٍ كَقَاصِرٍ يُعَدّْ","b":"مَهْمَا يَكُ الْمَقْصُودُ نِسْبَةً فَقَدْ"},{"a":"وَيُحْذَفُ الْمَفْعُولُ لِلتَّعْمِيمِ","b":"وَهُجْنَةٍ فَاصِلَةٍ تَفْهِيمِ"},{"a":"مِنْ بَعْدِ إِبْهَامٍ وَالِاخْتِصَارِ","b":"كَبَلَغَ الْمُولَعُ بِالْأَذْكَارِ"},{"a":"وَجَاءَ لِلتَّخْصِيصِ قَبْلَ الْفِعْلِ","b":"تَهَمُّمٍ تَبَرُّكٍ وَفَصْلِ"},{"a":"وَاحْكُمْ لِمَعْلُولَاتِهِ بِمَا ذُكِرْ","b":"وَالسِّرُّ فِي التَّرْتِيبِ فِيهَا مُشْتَهِرْ"},{"a":"تَخْصِيصُ أَمْرٍ مُطْلَقًا بِأَمْرِ","b":"هُوَ الَّذِي يَدْعُونَهُ بِالْقَصْرِ"},{"a":"يَكُونُ فِي الْمَوْصُوفِ وَالْأَوْصَافِ","b":"وَهْوَ حَقِيقِيٌّ كَمَا إِضَافِي"},{"a":"لِقَلْبٍ اوْ تَعْيِينٍ اوْ إِفْرَادِ","b":"كَإِنَّمَا تَرْقَى بِالِاسْتِعْدَادِ"},{"a":"وَأَدَوَاتُ الْقَصْرِ إِلَّا إِنَّمَا","b":"عَطْفٌ وَتَقْدِيمٌ وَمَا تَقَدَّمَا"},{"a":"مَا لَمْ يَكُنْ مُحْتَمِلًا لِلصِّدْقِ","b":"وَالْكَذِبِ الْإِنْشَا كَكُنْ بِالْحَقِّ"},{"a":"وَالطَّلَبُ اسْتِدْعَاءُ مَا لَمْ يَحْصُلِ","b":"أَقْسَامُهُ كَثِيرَةٌ سَتَنْجَلِي"},{"a":"أَمْرٌ وَنَهْيٌ وَدُعَاءٌ وَنِدَا","b":"تَمَنٍّ اسْتِفْهَامٌ أُعْطِيتَ الْهُدَى"},{"a":"وَاسْتَعْمَلُوا كَلَيْتَ لَوْ وَهَلْ لَعَلْ","b":"وَحَرْفَ حَضٍّ وَلِلِاسْتِفْهَامِ هَلْ"},{"a":"أَيٌّ مَتَى أَيَّانَ أَيْنَ مَنْ وَمَا","b":"وَكَيْفَ أَنَّى كَمْ وَهَمْزٌ عُلِمَا"},{"a":"وَالْهَمْزُ لِلتَّصْدِيقِ وَالتَّصَوُّرِ","b":"وَبِالَّذِي يَلِيهِ مَعْنَاهُ حَرِي"},{"a":"وَهَلْ لِتَصْدِيقٍ بِعَكْسِ مَا غَبَرْ","b":"وَلَفْظُ الِاسْتِفْهَامِ رُبَّمَا عَبَرْ"},{"a":"لِأَمْرٍ اسْتِبْطَاءٍ اوْ تَقْرِيرِ","b":"تَعَجُّبٍ تَهَكُّمٍ تَحْقِيرِ"},{"a":"تَنْبِيهٍ اسْتِبْعَادٍ اوْ تَرْهِيبِ","b":"إِنْكَارِ ذِي تَوْبِيخٍ اوْ تَكْذِيبِ"},{"a":"وَقَدْ يَجِي أَمْرٌ وَنَهْيٌ وَنِدَا","b":"فِي غَيْرِ مَعْنَاهُ لِأَمْرٍ قُصِدَا"},{"a":"وَصِيغَةُ الْأَخْبَارِ تَأْتِي لِلطَّلَبْ","b":"لِفَأْلٍ اوْ حِرْصٍ وَحَمْلٍ وَأَدَبْ"},{"a":"اَلْفَصْلُ تَرْكُ عَطْفِ جُمْلَةٍ أَتَتْ","b":"مِنْ بَعْدِ أُخْرَى عَكْسَ وَصْلٍ قَدْ ثَبَتْ"},{"a":"فَافْصِلْ لَدَى التَّوْكِيدِ وَالْإِبْدَالِ","b":"لِنُكْتَةٍ وَنِيَّةِ السُّؤَالِ"},{"a":"وَعَدَمِ التَّشْرِيكِ فِي حُكْمٍ جَرَى","b":"أَوِ اخْتِلَافٍ طَلَبًا وَخَبَرَا"},{"a":"وَفَقْدِ جَامِعٍ وَمَعْ إِيهَامِ","b":"عَطْفٍ سِوَى الْمَقْصُودِ فِي الْكَلَامِ"},{"a":"وَصِلْ لَدَى التَّشْرِيكِ فِي الْإِعْرَابِ","b":"وَقَصْدِ رَفْعِ اللَّبْسِ فِي الْجَوَابِ"},{"a":"وَفِي اتِّفَاقٍ مَعَ الِاتِّصَالِ","b":"فِي عَقْلٍ اوْ فِي وَهْمٍ اوْ خَيَالِ"},{"a":"وَالْوَصْلُ مَعْ تَنَاسُبٍ فِي اسْمٍ وَفِي","b":"فِعْلٍ وَفَقْدِ مَانِعٍ قَدِ اصْطُفِي"},{"a":"تَأْدِيَةُ الْمَعْنَى بِلَفْظِ قَدْرِهِ","b":"هِيَ الْمُسَاوَاةُ كَسِرْ بِذِكْرِهِ"},{"a":"وَبِأَقَلَّ مِنْهُ إِيجَازٌ عُلِمْ","b":"وَهْوَ إِلَى قَصْرٍ وَحَذْفٍ يَنْقَسِمْ"},{"a":"كَعَنْ مَجَالِسِ الْفُسُوقِ بُعْدَا","b":"وَلَا تُصَاحِبْ فَاسِقًا فَتَرْدَى"},{"a":"وَعَكْسُهُ يُعْرَفُ بِالْإِطْنَابِ","b":"كَالْزَمْ رَعَاكَ اللهُ قَرْعَ الْبَابِ"},{"a":"يَجِيءُ بِالْإِيضَاحِ بَعْدَ اللَّبْسِ","b":"لِشَوْقٍ اوْ تَمَكُّنٍ فِي النَّفْسِ"},{"a":"وَجَاءَ بِالْإِيغَالِ وَالتَّذْيِيِلِ","b":"تَكْرِيرٍ اعْتِرَاضٍ اوْ تَكْمِيلِ"},{"a":"يُدْعَى بِالِاحْتِرَاسِ وَالتَّتْمِيمِ","b":"وَقَفْوِ ذِي التَّخْصِيصِ ذَا التَّعْمِيمِ"},{"a":"وَوَصْمَةُ الْإِخْلَالِ وَالتَّطْوِيلِ","b":"وَالْحَشْوِ مَرْدُودٌ بِلَا تَفْصِيلِ"},{"a":"فَنُّ الْبَيَانِ عِلْمُ مَا بِهِ عُرِفْ","b":"تَأْدِيَةُ الْمَعْنَى بِطُرْقٍ مُخْتَلِفْ"},{"a":"وُضُوحُهَا وَاحْصُرْهُ فِي ثَلَاثَةِ","b":"تَشْبِيهٍ اوْ مَجَازٍ اوْ كِنَايَةِ"},{"a":"وَالْقَصْدُ بِالدَّلَالَةِ الْوَضْعِيَّهْ","b":"عَلَى الْأَصَحِّ الْفَهْمُ لَا الْحَيْثِيَّهْ"},{"a":"أَقْسَامُهَا ثَلَاثَةٌ مُطَابَقَهْ","b":"تَضَمُّنٌ الْتِزَامٌ امَّا السَّابِقَهْ"},{"a":"فَهْيَ الْحَقِيقَهْ لَيْسَ فِي الْبَيَانِ","b":"بَحْثٌ لَهَا وَعَكْسُهَا الْعَقْلِيَّتَانِ"},{"a":"تَشْبِيهُنَا دَلَالَةٌ عَلَى اشْتِرَاكْ","b":"أَمْرَيْنِ فِي مَعْنًى بِآلَةٍ أَتَاكْ"},{"a":"أَرْكَانُهُ أَرْبَعَةٌ وَجْهٌ أَدَاهْ","b":"وَطَرَفَاهُ فَاتَّبِعْ سُبْلَ النَّجَاهْ"},{"a":"فَصْلٌ وَحِسِّيَّانِ مِنْهُ الطَّرَفَانْ","b":"أَيْضًا وَعَقْلِيَّانِ أَوْ مُخْتَلِفَانْ"},{"a":"وَالْوَجْهُ مَا يَشْتَرِكَانِ فِيهِ","b":"وَدَاخِلًا وَخَارِجًا تُلْفِيهِ"},{"a":"وَخَارِجٌ وَصْفٌ حَقِيقِيٌّ جَلَا","b":"بِحِسٍّ اوْ عَقْلٍ وَنِسْبِيٌّ تَلَا"},{"a":"وَوَاحِدًا يَكُونُ أَوْ مُؤَلَّفَا","b":"أَوْ مُتَعَدِّدًا وَكُلٌّ عُرِفَا"},{"a":"بِحِسٍّ اوْ عَقْلٍ وَتَشْبِيهٌ نُمِي","b":"فِي الضِّدِّ لِلتَّلْمِيحِ وَالتَّهَكُّمِ"},{"a":"أَدَاتُهُ كَافٌ كَأَنَّ مِثْلُ","b":"وَكُلُّ مَا ضَاهَاهُ ثُمَّ الْأَصْلُ"},{"a":"إِيلَاءُ مَا كَالْكَافِ مَا شُبِّهَ بِهْ","b":"بِعَكْسِ مَا سِوَاهُ فَاعْلَمْ وَانْتَبِهْ"},{"a":"وَغَايَةُ التَّشْبِيهِ كَشْفُ الْحَالِ","b":"مِقْدَارٍ اوْ إِمَكَانٍ اوْ إِيصَالِ"},{"a":"تَزْيِينٌ اوْ تَشْوِيهٌ اهْتِمَامُ","b":"تَنْوِيهٌ اسْتِطْرَافٌ اوْ إِيهَامُ"},{"a":"رُجْحَانِهِ فِي الْوَجْهِ بِالْمَقْلُوبِ","b":"كَاللَّيْثُ مِثْلُ الْفَاسِقِ الْمَصْحُوبِ"},{"a":"وَبِاعْتِبَارِ طَرَفَيْهِ يَنْقَسِمْ","b":"أَرْبَعَةً تَرْكِيبًا افْرَادًا عُلِمْ"},{"a":"وَبِاعْتِبَارِ عَدَدٍ مَلْفُوفٌ اوْ","b":"مَفْرُوقٌ اوْ تَسْوِيَةٌ جَمْعٌ رَأَوْا"},{"a":"وَبِاعْتِبَارِ الْوَجْهِ تَمْثِيلٌ إِذَا","b":"مِنْ مُتَعَدِّدٍ تَرَاهُ أُخِذَا"},{"a":"وَبِاعْتِبَارِ الْوَجْهِ أَيْضًا مُجْمَلُ","b":"خَفِيٌّ اوْ جَلِيٌّ اوْ مُفَصَّلُ"},{"a":"وَمِنْهُ بِاعْتِبَارِهِ أَيْضًا قَرِيبْ","b":"وَهْوَ جَلِيُّ الْوَجْهِ عَكْسُهُ الْغَرِيبْ"},{"a":"لِكَثْرَةِ التَّفْصِيلِ بُعْدِ النِّسْبَةِ","b":"وَالذِّكْرِ وَالتَّرْتِيبِ فِي كَنُهْيَةِ"},{"a":"وَبِاعْتِبَارِ آلَةٍ مُؤَكَّدُ","b":"بِحَذْفِهَا وَمُرْسَلٌ إِذْ تُوجَدُ"},{"a":"وَمِنْهُ مَقْبُولٌ بِغَايَةٍ يَفِي","b":"وَعَكْسُهُ الْمَرْدُودُ وَالتَّعَسُّفِ"},{"a":"وَأَبْلَغُ التَّشْبِيهِ مَا مِنْهُ حُذِفْ","b":"وَجْهٌ وَآلَةٌ يَلِيهِ مَا عُرِفْ"},{"a":"حَقِيقَةٌ مُسْتَعْمَلٌ فِيمَا وُضِعْ","b":"لَهُ بِعُرْفِ ذِي الْخِطَابِ فَاتَّبِعْ"},{"a":"ثُمَّ الْمَجَازُ قَدْ يَجِيءُ مُفْرَدَا","b":"وَقَدْ يَجِي مُرَكَّبًا فَالْمُبْتَدَا"},{"a":"كَلِمَةٌ غَابَرَتِ الْمَوْضُوعَ مَعْ","b":"قَرِينَةٍ لِعُلْقَةٍ نِلْتَ الْوَرَعْ"},{"a":"كَاخْلَعْ نِعَالَ الْكَوْنِ كَيْ تَرَاهُ","b":"وَغُضَّ طَرْفَ الْقَلْبِ عَنْ سِوَاهُ"},{"a":"كِلَاهُمَا شَرْعِيٌّ اوْ عُرْفِيُّ","b":"نَحْوُ ارْتَقَى لِلْحَضْرَةِ الصُّوفِيُّ"},{"a":"أَوْ لُغَوِيٌّ وَالْمَجَازُ مُرْسَلُ","b":"أَوِ اسْتِعَارَةٌ فَأَمَّا الْأَوَّلُ"},{"a":"فَمَا سِوَى تَشَابُهٍ عَلَاقَتُهْ","b":"جُزْءٌ وَكُلٌّ أَوْ مَحَلٌّ آلَتُهْ"},{"a":"ظَرْفٌ وَمَظْرُوفٌ مُسَبَّبٌ سَبَبْ","b":"وَصْفٌ لِمَاضٍ أَوْ مَآلٍ مُرْتَقَبْ"},{"a":"وَالِاسْتِعَارَةُ مَجَازٌ عُلْقَتُهْ","b":"تَشَابُهٌ كَأَسَدٍ شَجَاعَتُهْ"},{"a":"وَهْيَ مَجَازٌ لُغَةً عَلَى الْأَصَحّْ","b":"وَمُنِعَتْ فِي عَلَمٍ لِمَا اتَّضَحْ"},{"a":"وَفَرْدًا اوْ مَعْدُودًا اوْ مُؤَلَّفَا","b":"مِنْهُ قَرِينَةٌ لَهَا قَدْ أُلِفَا"},{"a":"وَمَعْ تَنَافِي طَرَفَيْهَا تُنْتَمَى","b":"إِلَى الْعِنَادِ وَالْوِفَاقِ فَاعْلَمَا"},{"a":"ثُمَّ الْعِنَادِيَّةُ تَلْمِيحِيَّهْ","b":"تُلْفَى كَمَا تُلْفَى تَهَكُّمِيَّهْ"},{"a":"وَبِاعْتِبَارِ جَامِعٍ قَرِيبَهْ","b":"كَقَمَرٌ يَقْرَأُ أَوْ غَرِيبَهْ"},{"a":"وَبِاعْتِبَارِ جَامِعٍ وَطَرَفَيْنِ","b":"حِسًّا وَعَقْلًا سِتَّةٌ بِغَيْرِ مَيْنِ"},{"a":"وَاللَّفْظُ إِنْ جِنْسًا فَقُلْ أَصْلِيَّهْ","b":"وَتَبَعِيَّةً لَدَى الْوَصْفِيَّهْ"},{"a":"وَالْفِعْلِ وَالْحَرْفِ كَحَالِ الصُّوفِي","b":"يَنْطِقُ أَنَّهُ الْمُنِيبُ الْمُوفِي"},{"a":"وَأَطْلَقَتْ وَهْيَ الَّتِي لَمْ تَقْتَرِنْ","b":"بِوَصْفٍ اوْ تَفْرِيعِ أَمْرٍ فَاسْتَبِنْ"},{"a":"وَجُرِّدَتْ بِلَائِقٍ بِالْفَصْلِ","b":"وَرُشِّحَتْ بِلَائِقٍ بِالْأَصْلِ"},{"a":"نَحْوُ ارْتَقَى إِلَى السَّمَاءِ الْقُدْسِ","b":"فَفَاقَ مَنْ خَلَّفَ أَرْضَ الْحِسِّ"},{"a":"أَبْلَغُهَا التَّرْشِيحُ لِابْتِنَائِهْ","b":"عَلَى تَنَاسِي الشِّبْهِ وَانْتِفَائِهْ"},{"a":"وَذَاتُ مَعْنًى ثَابِتٍ بِحِسٍّ اوْ","b":"عَقْلٍ فَتَحْقِيقِيَّةٌ كَذَا رَأَوْا"},{"a":"كَأَشْرَقَتْ بَصَائِرُ الصُّوفِيَّهْ","b":"بِنُورِ شَمْسِ الْحَضْرَةِ الْقُدْسِيَّهْ"},{"a":"وَحَيْثُ تَشْبِيهٌ بِنَفْسٍ أُضْمِرَا","b":"وَمَا سِوَى مُشَبَّهٍ لَمْ يُذْكَرَا"},{"a":"وَدَلَّ لَازِمٌ لِمَا شُبِّهَ بِهْ","b":"فَذَلِكَ التَّشْبِيهُ عِنْدَ الْمُنْتَبِهْ"},{"a":"يُعْرَفُ بِاسْتِعَارَةِ الْكِنَايَةِ","b":"وَذِكْرُ لَازِمٍ بِتَخْيِيلِيَّةِ"},{"a":"كَأَنْشَبَتْ مَنِيَّةٌ أَظْفَارَهَا","b":"وَأَشْرَقَتْ حَضْرَتُهَا أَنْوَارَهَا"},{"a":"مُحَسِّنُ اسْتِعَارَةٍ تَدْرِيهِ","b":"بِرَعْيِ وَجْهِ الْحُسْنِ لِلتَّشْبِيهِ"},{"a":"وَالْبُعْدُ عَنْ رَائِحَةِ التَّشْبِيهِ فِي","b":"لَفْظٍ وَلَيْسَ الْوَجْهُ أَلْغَازًا قُفِي"},{"a":"مُرَكَّبُ الْمَجَازِ مَا تَحَصَّلَا","b":"فِي نِسْبَةٍ أَوْ مِثْلَ تَمْثِيلٍ جَلَا"},{"a":"وَإِنْ أَتَى اسْتِعَارَةً مُرَكَّبُ","b":"فَمَثَلًا يُدْعَى وَلَا يُنَكَّبُ"},{"a":"وَمِنْهُ مَا إِعْرَابُهُ تَغَيَّرَا","b":"بِحَذْفِ لَفْظٍ أَوْ زِيَادَةٍ تُرَى"},{"a":"لَفْظٌ بِهِ لَازِمُ مَعْنَاهُ قُصِدْ","b":"مَعَ جَوَازِ قَصْدِهِ مَعْهُ يَرِدْ"},{"a":"إِلَى اخْتِصَاصِ الْوَصْفِ بِالْمَوْصُوفِ","b":"كَالْخَيْرُ فِي الْعُزْلَةِ يَا ذَا الصُّوفِي"},{"a":"وَنَفْسِ مَوْصُوفٍ وَوَصْفٍ وَالْغَرَضْ","b":"إِيضَاحٌ اخْتِصَارٌ اوْ صَوْنٌ عَرَضْ"},{"a":"أَو انْتِقَاءُ اللَّفْظِ لَاسْتِهْجَانِ","b":"وَنَحْوِهِ كَاللَّمْسِ وَالْإِتْيَانِ"},{"a":"ثُمَّ الْمَجَازُ وَالْكُنَى أَبْلَغُ مِنْ","b":"تَصْرِيحٍ اوْ حَقِيقَةٍ كَذَا زُكِنْ"},{"a":"فِي الْفَنِّ تَقْدِيمُ اسْتِعَارَةٍ عَلَى","b":"تَشْبِيهٍ ايْضًا بِاتِّفَاقِ الْعُقَلَا"},{"a":"عِلْمٌ بِهِ وُجُوهُ تَحْسِينِ الْكَلَامْ","b":"يُعْرَفُ بَعْدَ رَعْيِ سَابِقِ الْمَرَامْ"},{"a":"ثُمَّ وُجُوهُ حُسْنِهِ ضَرْبَانِ","b":"بِحَسَبِ الْأَلْفَاظِ وَالْمَعَانِي"},{"a":"وَعُدَّ مِنْ أَلْقَابِهِ الْمُطَابَقَهْ","b":"تَشَابُهُ الْأَطْرَافِ وَالْمُوَافَقَهْ"},{"a":"وَالْعَكْسُ وَالتَّسْهِيمُ وَالْمُشَاكَلَهْ","b":"تَزَاوُجٌ رُجُوعٌ اوْ مُقَابَلَهْ"},{"a":"تَوْرِيَةٌ تُدْعَى بِإِيهَامٍ لِمَا","b":"أُرِيدَ مَعْنَاهُ الْبَعِيدُ مِنْهُمَا"},{"a":"وَرُشِّحَتْ بِمَا يُلَائِمُ الْقَرِيبْ","b":"وَجُرِّدَتْ بِفَقْدِهِ فَكُنْ مُنِيبْ"},{"a":"جَمْعٌ وَتَفْرِيقٌ وَتَقْسِيمٌ وَمَعْ","b":"كِلَيْهِمَا أَوْ وَاحِدٍ جَمْعٌ يَقَعْ"},{"a":"وَاللَّفُّ وَالنَّشْرُ وَالِاسْتِخْدَامُ","b":"أَيْضًا وَتَجْرِيدٌ لَهُ أَقْسَامُ"},{"a":"ثُمَّ الْمُبَالَغَةُ وَصْفٌ يُدَّعَى","b":"بُلُوغُهُ قَدْرًا يُرَى مُمْتَنِعَا"},{"a":"أَوْ نَائِيًا وَهْوَ عَلَى أَنْحَاءِ","b":"تَبْلِيغٌ اغْرَاقٌ غُلُوٌّ جَائِي"},{"a":"مَقْبُولًا اوْ مَرْدُودًا التَّفْرِيعُ","b":"وَحُسْنُ تَعْلِيلٍ لَهُ تَنْوِيعُ"},{"a":"وَقَدْ أَتَوْا فِي الْمَذْهَبِ الْكَلَامِي","b":"بِحُجَجٍ كَمَهْيَعِ الْكَلَامِ"},{"a":"وَأَكَّدُوا مَدْحًا بِشِبْهِ الذَّمِّ","b":"كَالْعَكْسِ وَالْإِدْمَاجُ مِنْ ذَا الْعِلْمِ"},{"a":"وَجَاءَ الِاسْتِتْبَاعُ وَالتَّوْجِيهُ مَا","b":"يَحْتَمِلُ الْوَجْهَيْنِ عِنْدَ الْعُلَمَا"},{"a":"وَمِنْهُ قَصْدُ الْجَدِّ بِالْهَزْلِ كَمَا","b":"يُثْنَى عَلَى الْفَخُورِ ضِدَّ مَا اعْتَمَا"},{"a":"وَسَوْقُ مَعْلُومٍ مَسَاقَ مَا جُهِلْ","b":"لِنُكْتَةٍ تَجَاهُلٌ عَنْهُمْ نُقِلْ"},{"a":"وَالْقَوْلُ بِالْمُوجَبِ قُلْ ضَرْبَانِ","b":"كِلَاهُمَا فِي الْفَنِّ مَعْلُومَانِ"},{"a":"وَالِاطِّرَادُ الْعَطْفُ بِالْآبَاءِ","b":"لِلشَّخْصِ مُطْلَقًا عَلَى الْوِلَاءِ"},{"a":"مِنْهُ الْجِنَاسُ وَهْوَ ذُو تَمَامِ","b":"مَعَ اتِّحَادِ الْحَرْفِ وَالنِّظَامِ"},{"a":"وَمُتَمَاثِلًا دُعِي إِنِ ائْتَلَفْ","b":"نَوْعًا وَمُسْتَوْفًى إِذَا النَّوْعُ اخْتَلَفْ"},{"a":"لَنْ يَعْرِفَ الْوَاحِدَ إِلَّا وَاحِدَا","b":"فَاخْرُجْ عَنِ الْكَوْنِ تَكُنْ مُشَاهِدَا"},{"a":"وَمِنْهُ ذُو التَّرْكِيبِ ذُو تَشَابُهِ","b":"خَطًّا وَمَفْرُوقٌ بِلَا تَشَابُهِ"},{"a":"وَإِنْ بِهَيْئَةِ الْحُرُوفِ اخْتَلَفَا","b":"فَهْوَ الَّذِي يَدْعُونَهُ الْمُحَرَّفَا"},{"a":"وَنَاقِصٌ مَعَ اخْتِلَافٍ فِي الْعَدَدْ","b":"وَشَرْطُ خُلْفِ النَّوْعِ وَاحِدٌ فَقَدْ"},{"a":"وَمَعْ تَقَارُبٍ مُضَارِعًا أُلِفْ","b":"وَمَعْ تَبَاعُدٍ بِلَاحِقٍ وُصِفْ"},{"a":"وَهْوَ جِنَاسُ الْقَلْبِ حَيْثُ يَخْتَلِفْ","b":"تَرْتِيبُهَا لِلْكُلِّ وَالْبَعْضِ أَضِفْ"},{"a":"مُجَنَّحًا يُدْعَى إِذَا تَقَاسَمَا","b":"بَيْتًا فَكَانَ فَاتِحًا وَخَاتِمَا"},{"a":"وَمَعْ تَوَالِي الطَّرَفَيْنِ عُرِفَا","b":"مُزْدَوِجًا كُلُّ جِنَاسٍ أُلِفَا"},{"a":"تَنَاسُبُ اللَّفْظَيْنِ فِي اشْتِقَاقِ","b":"وَشِبْهِهِ فَذَاكَ ذُو الْتِحَاقِ"},{"a":"وَيَرِدُ التَّجْنِيسُ بِالْإِشَارَةِ","b":"مِنْ غَيْرِ أَنْ يُذْكَرَ فِي الْعِبَارَةِ"},{"a":"وَمِنْهُ رَدُّ عَجُزِ اللَّفْظِ عَلَى","b":"صَدْرٍ فَفِي نَثْرٍ بِفَقْرَةٍ جَلَا"},{"a":"مُكْتَنِفًا وَالنَّظْمِ الَاوَّلْ أَوَّلَا","b":"آخِرَ مِصْرَاعٍ فَمَا قَبْلُ تَلَا"},{"a":"مُكَرَّرًا مُجَانِسًا وَمَا الْتَحَقْ","b":"يَأْتِي كَ﴿تَخْشَى النَّاسَ وَاللهُ أَحَقّْ﴾"},{"a":"وَالسَّجْعُ فِي فَوَاصِلٍ فِي النَّثْرِ","b":"مُشْبِهَةً قَافِيَةً فِي الشِّعْرِ"},{"a":"ضُرُوبُهُ ثَلَاثَةٌ فِي الْفَنِّ","b":"مُطَرَّفٌ مَعَ اخْتِلَافِ الْوَزْنِ"},{"a":"مُرَصَّعٌ إِنْ كَانَ مَا فِي الثَّانِيَهْ","b":"أَوْ جُلُّهُ عَلَى وِفَاقِ الْمَاضِيَهْ"},{"a":"وَمَا سِوَاهُ الْمُتَوَازِي فَادْرِي","b":"كَسُرُرٍ مَرْفُوعَةٍ فِي الذِّكْرِ"},{"a":"أَبْلَغُ ذَاكَ مُسْتَوٍ فَمَا تُرَى","b":"أُخْرَى الْقَرِينَتَيْنِ فِيهِ أَكْثَرَا"},{"a":"وَالْعَكْسُ إِنْ يَكْثُرْ فَلَيْسَ يَحْسُنُ","b":"وَمُطْلَقًا إِعْجَازُهَا تُسَكَّنُ"},{"a":"وَجَعْلُ سَجْعِ كُلِّ شَطْرٍ غَيْرَمَا","b":"فِي الْآخَرِ التَّشْطِيرُ عِنْدَ الْعُلَمَا"},{"a":"ثُمَّ الْمُوَازَنَةُ وَهْيَ التَّسْوِيَهْ","b":"لِفَاصِلٍ فِي الْوَزْنِ لَا فِي التَّقْفِيَهْ"},{"a":"وَهْيَ الْمُمَاثَلَةُ حَيْثُ يَتَّفِقْ","b":"فِي الْوَزْنِ لَفْظُ فَقْرَتَيْهَا فَاسْتَفِقْ"},{"a":"وَالْقَلْبُ وَالتَّشْرِيعُ وَالْتِزَامُ مَا","b":"قَبْلَ الرَّوِيِّ ذِكْرُهُ لَنْ يَلْزَمَا"},{"a":"وَأَخْذُ شَاعِرٍ كَلَامًا سَبَقَهْ","b":"هُوَ الَّذِي يَدْعُونَهُ بِالسَّرِقَهْ"},{"a":"وَكُلُّ مَا قُرِّرَ فِي الْأَلْبَابِ","b":"أَوْ عَادَةٍ فَلَيْسَ مِنْ ذَا الْبَابِ"},{"a":"وَالسَّرِقَاتُ عَنْدَهُمْ قِسْمَانِ","b":"خَفِيَّةٌ جَلِيَّةٌ وَالثَّانِي"},{"a":"تَضَمُّنُ الْمَعْنَى جَمِيعًا مُسْجَلَا","b":"أَرْدَؤُهُ انْتِحَالُ مَا قَدْ نُقِلَا"},{"a":"بِحَالِهِ وَأَلْحَقُوا الْمُرَادِفَا","b":"بِهِ وَيُدْعَى مَا أَتَى مُخَالِفَا"},{"a":"لِنَظْمِهِ إِغَارَةً وَحُمِدَا","b":"حَيْثُ مِنَ السَّابِقِ كَانَ أَجْوَدَا"},{"a":"وَأَخْذُهُ الْمَعْنَى مُجَرَّدًا دُعِي","b":"سَلْخًا وَإِلْمَامًا وَتَقْسِيمًا فَعِي"},{"a":"وَمَا سِوَى الظَّاهِرِ أَنْ يُغَيَّرَا","b":"مَعْنًى بِوَجْهٍ مَا وَمَحْمُودًا يُرَى"},{"a":"لِنَقْلٍ اوْ خَلْطٍ شُمُولِ الثَّانِي","b":"وَقَلْبٍ اوْ تَشَابُهِ الْمَعَانِي"},{"a":"أَحْوَالُهُ بِحَسَبِ الْخَفَاءِ","b":"تَفَاضَلَتْ فِي الْحُسْنِ وَالثَّنَاءِ"},{"a":"وَالِاقْتِبَاسُ أَنْ يُضَمَّنَ الْكَلَامْ","b":"قُرْآنًا اوْ حَدِيثَ سَيِّدِ الْأَنَامْ"},{"a":"وَالِاقْتِبَاسُ عِنْدَهُمْ ضَرْبَانِ","b":"مُحَوَّلٌ وَثَابِتُ الْمَعَانِي"},{"a":"وَجَائِزٌ لِوَزْنٍ اوْ سِوَاهُ","b":"تَغْيِيرُ نَزْرِ اللَّفْظِ لَا مَعْنَاهُ"},{"a":"وَالْأَخْذُ مِنْ شِعْرٍ بِعَزْوِ مَا خَفِي","b":"تَضْمِينُهُمْ وَمَا عَلَى الْأَصْلِ يَفِي"},{"a":"بِنُكْتَةٍ أَجَلُّهُ وَاغْتُفِرَا","b":"يَسِيرُ تَغْيِيرٍ وَمَا مِنْهُ يُرَى"},{"a":"بَيْتًا فَأَعْلَى بِاسْتِعَانَةٍ عُرِفْ","b":"وَشَطْرًا اوْ أَدْنَى بِإِيدَاعٍ أُلِفْ"},{"a":"وَالْعَقْدُ نَظْمُ النَّثْرِ لَا بِالِاقْتِبَاسْ","b":"وَالْحَلُّ نَثْرُ النَّظْمِ فَاعْرِفِ الْقِيَاسْ"},{"a":"وَاشْتَرَطُوا الشُّهْرَةَ فِي الْكَلَامِ","b":"وَالْمَنْعُ أَصْلُ مَذْهَبِ الْإِمَامِ"},{"a":"إِشَارَةٌ لِقِصَّةٍ شِعْرٍ مَثَلْ","b":"مِنْ غَيْرِ ذِكْرِهِ فَتَلْمِيحٌ كَمُلْ"},{"a":"مِنْ ذَلِكَ التَّوْشِيعُ وَالتَّرْدِيدُ","b":"تَرْتِيبٌ اخْتِرَاعٌ اوْ تَعْدِيدُ"},{"a":"كَ﴿التَّائِبُونَ الْعَابِدُونَ الْحَامِدُونْ","b":"اَلسَّائِحُونَ الرَّاكِعُونَ السَّاجِدُونْ﴾"},{"a":"تَطْرِيزٌ اوْ تَدْبِيجٌ اسْتِشْهَادُ","b":"إِيضَاحٌ ائْتِلَافٌ اسْتِطْرَادُ"},{"a":"إِحَالَةٌ تَلْوِيحٌ اوْ تَخْيِيلُ","b":"وَفُرْصَةٌ تَسْمِيطٌ اوْ تَعْدِيلُ"},{"a":"تَحْلِيَةٌ أَوْ نَفْلٌ اوْ تَخَتُّمُ","b":"تَجْرِيدٌ اسْتِقْلَالٌ اوْ تَهَكُّمُ"},{"a":"تَعْرِيضٌ اوْ إِلْغَازٌ ارْتِقَاءُ","b":"تَنْزِيلٌ اوْ تَأْنِيسٌ اوْ إِيمَاءُ"},{"a":"حُسْنُ الْبَيَانِ وَصْفٌ اوْ مُرَاجَعَهْ","b":"حُسْنُ تَخَلُّصٍ بِلَا مُنَازَعَهْ"},{"a":"وَلَيْسَ فِي الْإِيهَامِ وَالتَّهَكُّمِ","b":"وَلَا التَّغَالِي بِسِوَى الْمُحَرَّمِ"},{"a":"مِنْ كَذِبٍ وَفِي الْمِزَاحِ قَدْ لَزِبْ","b":"بِحَيْثُ لَا مَنْدُوحَةٌ عَنِ الْكَذِبْ"},{"a":"وَيَنْبَغِي لِصَاحِبِ الْكَلَامِ","b":"تَأَنُّقٌ فِي الْبَدْءِ وَالْخِتَامِ"},{"a":"بِمَطْلَعٍ حَسَنٍ وَحُسْنِ الْفَالِ","b":"وَسَبْكٍ اوْ بَرَاعَةِ اسْتِهْلَالِ"},{"a":"وَالْحُسْنُ فِي تَخَلُّصٍ أَوِ اقْتِضَابْ","b":"وَفِي الَّذِي يَدْعُونَهُ فَصْلَ الْخِطَابْ"},{"a":"وَمِنْ سِمَاتِ الْحُسْنِ فِي الْخِتَامِ","b":"إِرْدَافُهُ بِمُشْعِرِ التَّمَامِ"},{"a":"هَذَا تَمَامُ الْجُمْلَةِ الْمَقْصُودَهْ","b":"مِنْ صَنْعَةِ الْبَلَاغَةِ الْمَحْمُودَهْ"},{"a":"ثُمَّ صَلَاةُ اللهِ طُولَ الْأَمَدِ","b":"عَلَى النَّبِيِّ الْمُصْطَفَى مُحَمَّدِ"},{"a":"وَآلِهِ وَصَحْبِهِ الْأَخْيَارِ","b":"مَا غَرَّدَ الْمُشْتَاقُ بِالْأَسْحَارِ"},{"a":"وَخَرَّ سَاجِدًا إِلَى الْأَذْقَانِ","b":"يَبْغِي وَسِيلَةً إِلَى الرَّحْمَنِ"},{"a":"تَمَّ بِشَهْرِ الْحِجَّةِ الْمَيْمُونِ","b":"مُتِمِّ نِصْفِ عَاشِرِ الْقُرُونِ"}]