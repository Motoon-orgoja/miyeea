[{"n":"1","a":"الحمد لله الذي بأحمدا","b":"هدى إلى أقوم نهج من هدى"},
{"n":"2","a":"حمدا جديدا دائم البقاء","b":"مكافئا ترادف الآلاء"},
{"n":"3","a":"ثم الصلاة والسلام تترى","b":"على أجل المرسلين قدرا"},
{"n":"4","a":"وآله وصحبه ومن سلك","b":"سبيلهم مادار نجم في فلك"},
{"n":"5","a":"وبعد فاعلم أن خير ما اقتفى","b":"ذو همة سيرة خير مقتفى"},
{"n":"6","a":"وها أنا أذكر في هذا الرجز","b":"من ذاك ما فيه سداد من عوز"},
{"n":"7","a":"لمبتغي التحصيل من أولي الهدى","b":"عسى بنفعهم به أن أرشدا"},
{"n":"8","a":"سميته بقرة الأبصار","b":"في سيرة المشفع المختار"},
{"n":"9","a":"مرتبا له على الأبواب","b":"مقربا مقاصد الطلاب"},
{"n":"10","a":"ومن ممد الكون في إنعامه","b":"استوهب العون على إتمامه"},
{"n":"11","a":"والنفع للراوي وللمروي","b":"عنه بجاه المصطفى النبي"},
{"n":"12","a":"عليه أزكى صلوات الباري","b":"وآله وصحبه الأبرار"},
{"n":"13","a":"بيان نسبة النبي المصطفى","b":"صلى عليه ربنا وشرفا"},
{"n":"14","a":"ونسب المختار محفوظ إلى","b":"عدنان بالإجماع عند الفضلا"},
{"n":"15","a":"وها أنا أشير لاسم كل","b":"منهم بحرف منه مستقل"},
{"n":"16","a":"مع شه عق كم كلغفمن","b":"كخم أمن مع إلى هنا زكن"},
{"n":"17","a":"وشيبة إذ بير زمزم حفر","b":"همة بمنعه قريش فنذر"},
{"n":"18","a":"إن جاءه من البنين عشره","b":"يحمونه من البغاة الفجره"},
{"n":"19","a":"لينحرن واحدا تقربا","b":"به فلما رام نحره أبى"},
{"n":"20","a":"منه قريش فمضى لخيبرا","b":"مستأمرا كاهنها فأمرا"},
{"n":"21","a":"إن استهم عليه والإبال","b":"فإن عليه خرجت في الحال"},
{"n":"22","a":"فزد عليها عشرة واقترعا","b":"حتى إذا السهم عليها وقعا"},
{"n":"23","a":"فانحر فإن ربه قد رضيا","b":"بأنها له فداء فعيا"},
{"n":"24","a":"ففعل الذي به قد أمرا","b":"حتى انتهت لمائة فنحرا"},
{"n":"25","a":"من بعد ضربها ثلاثا وهي لا","b":"تعدو العشار الكوم فيما نقلا"},
{"n":"26","a":"وكان والد النبي المفتدى","b":"بمائة فداؤه من الردى"},
{"n":"27","a":"وكان ذاك سنة في أمته","b":"عن نفس كل مؤمن في فديته"},
{"n":"28","a":"والخلف في ثاني الذبيحين ورد","b":"فجلهم إسحاق وهو المعتمد"},
{"n":"29","a":"وقال قوم هو إسماعيل","b":"وكل قول فله دليل"},
{"n":"30","a":"ثالثها الوقف عن الزجاج","b":"فاسلك سبيلا غير ذي اعوجاج"},
{"n":"31","a":"بيان مولد النبي المجتبى","b":"صلى عليه الله ما هب الصبا"},
{"n":"32","a":"وحملة آمنة الزهرية","b":"طوبى لها بأكمل البرية"},
{"n":"33","a":"في رجب الفرد بدار وهب","b":"والدها وقيل بل في الشعب"},
{"n":"34","a":"وكان مولد النبي الهادي","b":"صلى عليه خالق العباد"},
{"n":"35","a":"عام قدوم الفيل للأقوام","b":"بإثر خمسين من الأيام"},
{"n":"36","a":"في يوم الاثنين من الشهر الأغر","b":"في ثالث الشهر أو الثاني عشر"},
{"n":"37","a":"أو لثمان من ربيع الأول","b":"موافق النيسان عند الأول"},
{"n":"36","a":"في عام (جفظ) من سني الإسكندر","b":"بطالع الجدي وكان المشتري"},
{"n":"37","a":"مع زحل في وسط السماء","b":"تقارنا بالعقرب الغراء"},
{"n":"38","a":"فغاضت المياه والنيران","b":"قد خمدت وانصدع الإيوان"},
{"n":"39","a":"وخرس الملوك والأصنام","b":"تناكست فما لها قيام"},
{"n":"40","a":"بيان موت والد المختار","b":"وكم له كان من الاظئار"},
{"n":"41","a":"ومات عبدالله وهو حمل","b":"وكم حوت من شرف هذيل"},
{"n":"42","a":"لما غدت بنتهم السعدية","b":"من أمهات أشرف البريه"},
{"n":"43","a":"وكم رأت له من الآيات","b":"حليمة منها درور الشاة"},
{"n":"44","a":"وشق صدر أكرم الأنام","b":"وهو ابن عامين وسدس عام"},
{"n":"45","a":"وشق للبعث وللإسراء","b":"أيضا كما قد جاء في الأنباء"},
{"n":"46","a":"وكم حوت ثويبة من بركه","b":"لما غدت ظئرا له وبركه"},
{"n":"47","a":"إذ حضنته ثم بعد الأم","b":"غدا كفيل الجد ثم العم"},
{"n":"48","a":"وخلفته أمه ابن أربع","b":"سنين والجد ابن ضعفها فعي"},
{"n":"49","a":"ثم إلى الشام مع العم ارتحل","b":"والعمر في ثالثة العشر دخل"},
{"n":"50","a":"فرده خوفا من اليهود","b":"عليه أهل المكر والجحود"},
{"n":"51","a":"وعاد مع ميسرة للشام","b":"وهو من الرحمن في إكرام"},
{"n":"52","a":"تظله الأملاك في المسير","b":"حين اشتداد الحر في الهجير"},
{"n":"53","a":"وإذ إلى مكة عاد وافتتح","b":"ستا وعشرين من العمر نكح"},
{"n":"54","a":"خديجة من بعد أربعينا","b":"مضت لها من عمرها سنينا"},
{"n":"55","a":"خير نساء الناس أجمعينا","b":"وقد أقامت معه عشرينا"},
{"n":"56","a":"وأربعا ورزق البنينا","b":"منها سوى أحدهم يقينا"},
{"n":"57","a":"ثم ابن خمس وثلاثين حضر","b":"بناء بيت الله إذ بنا الحجر"},
{"n":"58","a":"بيده الكريمة الزكيه","b":"صلى عليه بارئ البريه"},
{"n":"59","a":"بيان مبعث النبي الهادي","b":"صلى عليه خالق العباد"},
{"n":"60","a":"وجاءه جبريل في غار حرا","b":"من بعد أربعين عاما غبرا"},
{"n":"61","a":"في يوم الاثنين بسورة العلق","b":"صلى عليه الله فالق الفلق"},
{"n":"62","a":"فقام يدعو الإنس والجن إلى","b":"توحيد رب العالمين مرسلا"},
{"n":"63","a":"مؤيدا منه بما أعيا البشر","b":"إحصاؤه من معجزات كالمطر"},
{"n":"64","a":"نفعا وكثرة وكالسراج","b":"نورا ورفعة مع ابتهاج"},
{"n":"65","a":"ومع ذا حاصره الفجار","b":"كما أتت بذلك الأخبار"},
{"n":"66","a":"وكان قادرا على التدمير","b":"لو شاء لكن جاد بالتأخير"},
{"n":"67","a":"حتى هدى الله به من شاء","b":"منهم ومن أصلابهم أبناء"},
{"n":"68","a":"ثم أعز دينه ونصره","b":"وأيد الحق به وأظهره"},
{"n":"69","a":"وأبطل الباطل والأعداء","b":"كبتا وخزيا لهم جزاء"},
{"n":"70","a":"وأمد الحصار في الشعب على","b":"حولين أربا لا ثلاثا وصلا"},
{"n":"71","a":"وعندما انقضى الحصار عمره","b":"ستا وأربعين كان قدره"},
{"n":"72","a":"وبعد ما أكمل خمسين سنه","b":"جن نصيبين أتته مذعنه"},
{"n":"73","a":"وبعد واحد مع الخمسينا","b":"وأشهر مضت له يقينا"},
{"n":"74","a":"شرفه الرحمن بالإسراء","b":"وبعروجه إلى السماء"},
{"n":"75","a":"حتى أراه أكبر الآيات","b":"وعاد بعد الفرض للصلاة"},
{"n":"76","a":"صلى عليه ربنا وسلما","b":"وآله وصحبه وكرما"},
{"n":"77","a":"بيان هجرة النبي المختار","b":"والغزو والحج والاعتمار"},
{"n":"78","a":"وهاجر المختار لما أن وصل","b":"خمسين مع ثلاثة حتى نزل"},
{"n":"79","a":"بطيبة الغراء حيث أمرا","b":"ثم بها أقام حتى احتضرا"},
{"n":"80","a":"فيها فكانت أشرف البقاع","b":"أما ضريحه فبالإجماع"},
{"n":"81","a":"ومدة اللبث بها في العده","b":"عشر سنين يالها من مده"},
{"n":"82","a":"لقد غزا عشرين بعد خمس","b":"فيها وفي سبع بغير لبس"},
{"n":"83","a":"قاتل بدر أحد والخندق","b":"بني قريظة بني المصطلق"},
{"n":"84","a":"وغزوة الطائف مع حنين","b":"وضعفها البعوث دون مين"},
{"n":"85","a":"وقيل في النضير مع وادي القرى","b":"قاتل والغابة أيضا ذكرا"},
{"n":"86","a":"وحج حجتين ثم الفرضا","b":"واعتمر الأربع قالوا أيضا"},
{"n":"87","a":"وقال مالك ثلاثا اعتمر","b":"وحج مفردا فحقق الخبر"},
{"n":"88","a":"وكلهن كن في ذي القعده","b":"على الذي صححه من عدده"},
{"n":"89","a":"بيان أزواج النبي المصطفى","b":"صلى عليه ربنا وشرفا"},
{"n":"90","a":"وعدة الأزواج باتفاق","b":"(أي) أتى وجاء في البواقي"},
{"n":"91","a":"خلف تركنا ذكره فالمتفق","b":"عليه أولاهن ذكرها سبق"},
{"n":"92","a":"بنت خويلد التي قد صدقت","b":"قبل النساء بالنبي فارتقت"},
{"n":"93","a":"وما تزوج عليها أحدا","b":"حياتها من النساء أبدا"},
{"n":"94","a":"ثم تزوج ابنة الصديق","b":"وعمرها ست على التحقيق"},
{"n":"95","a":"بالبلد الحرام قبل الهجره","b":"بسنتين عند أهل الخبره"},
{"n":"96","a":"ثم بنا بها بعيد ما ارتحل","b":"لطيبة وعمرها تسعا وصل"},
{"n":"97","a":"ومات عنها وهي بنت (حي)","b":"صلى عليه رب كل شي"},
{"n":"98","a":"ولم يكن تزوج المختار","b":"بكرا سواها فلها الفخار"},
{"n":"99","a":"وكم حوت في مدة يسيرة","b":"من العلوم الجمة الغزيرة"},
{"n":"100","a":"وبالبقيع دفنت في (حن)","b":"ليلا وسودة سمت في السن"},
{"n":"101","a":"فوهبت ليلتها لها لكي","b":"تحشر في أزواجه بنت لؤي"},
{"n":"102","a":"وبعد موت زوجها السكران","b":"تزوجت خير بني عدنان"},
{"n":"103","a":"صلى عليه ربنا وسلما","b":"وآله وصحبه وكرما"},
{"n":"104","a":"وهاجرا في الدين هجرتين","b":"جزاهما الرحمن جنتين"},
{"n":"105","a":"وعام (ند) أو في خلافة عمر","b":"توفيت بطيبة فاقف الأثر"},
{"n":"106","a":"وحفصة تزوجت خير البشر","b":"بعد خنيس ثم لما أن صدر"},
{"n":"107","a":"طلاقها منه بردها أمر","b":"وموتها عام الجماعة ذكر"},
{"n":"108","a":"وزينب أم المساكين قتل","b":"بأحد عنها ابن جحش فقبل"},
{"n":"109","a":"تزوجت خير نبي وثوت","b":"شهرين أو ثلاثة ثم توت"},
{"n":"110","a":"ولم يمت حياته من النسا","b":"إلا خديجة وذي فاقتبسا"},
{"n":"111","a":"وبنت جحش بنت عمة الرسول","b":"زوجها الرحمن بارئ العقول"},
{"n":"112","a":"خير نبي إذ قضى منها الوطر","b":"زيد وماتت في خلافة عمر"},
{"n":"113","a":"إذ فتحت مصر وكانت أطولا","b":"نسائه يدا كما قد نقلا"},
{"n":"114","a":"وهند وهي كما لها من فضل","b":"تزوجت من بعد موت البعل"},
{"n":"115","a":"خير الورى وفي خلافة يزيد","b":"في عام ستين قضت بلا مزيد"},
{"n":"116","a":"وبالبقيع دفنت وهاجرا","b":"ثنتين في أول من قد هاجرا"},
{"n":"117","a":"ومن نساء المصطفى جويريه","b":"توفيت في عام(نو) لتدريه"},
{"n":"118","a":"وقد سباها في غزاة المصطلق","b":"من بعلها مسافع بالمندلق"},
{"n":"119","a":"ودفع النجوم لابن قيس","b":"عنها فما أبركها من عرس"},
{"n":"120","a":"إذ أرسل الناس السبايا طرا","b":"لما غدا المصطلقي صهرا"},
{"n":"121","a":"للمصطفى عليه من رب الأنام","b":"وآله أزكى الصلاة والسلام"},
{"n":"122","a":"ورملة بنت أبي سفيانا","b":"تزوجت خير الورى وكانا"},
{"n":"123","a":"وليها خالدا أو عثمانا","b":"عند النجاشي كما أتانا"},
{"n":"124","a":"فسلم المهر إليها أجمعا","b":"من الدنانير مآت أربعا"},
{"n":null,"a":"وعام سبع أهديت لأحمدا","b":"وموتها في عام (مد) قد بدا"},
{"n":"125","a":"وكم حوت من شرف صفيه","b":"لما غدت لأكرم البريه"},
{"n":"126","a":"زوجا وكانت سبيت في خيبرا","b":"فاختارها لنفسه خير الورى"},
{"n":"127","a":"وعتقها مهرا لها حقا جعل","b":"وعام خمسين بها الموت نزل"},
{"n":"128","a":"وعام سبع بعد فتح خيبرا","b":"ميمونة نكحها معتمرا"},
{"n":"129","a":"وبعد عوده بها كان البنا","b":"بسرف وكان ذاك مدفنا"},
{"n":"130","a":"لها وكانت آخر النساء","b":"تزوجا له بلا امتراء"},
{"n":"131","a":"عليه أزكى صلوات ربه","b":"والآل والأزواج ثم صحبه"},
{"n":null,"a":"وعام خمسين وواحد نزل","b":"بها الحمام عندما حان الأجل"},
{"n":"132","a":"ومهر كل كان خمسماية","b":"من الدراهم سوى صفية"},
{"n":"133","a":"ورملة فإنه تقدما","b":"بيان ما أصدق كلا منهما"},
{"n":"134","a":"بيان أولاد النبي أحمدا","b":"صلى عليه ربنا ومجدا"},
{"n":"135","a":"أبناؤه أربعة فيما ورد","b":"على اختلاف جاء في هذا العدد"},
{"n":"136","a":"فالقاسم الذي به قد كنيا","b":"وبعد عبدالله أيضا دعيا"},
{"n":"137","a":"بالطيب الطاهر فاللفظان","b":"ترادفا وقبل بل غيران"},
{"n":"138","a":"ورابع البنين إبراهيم","b":"عليهم الرضوان والتسليم"},
{"n":"139","a":"ميلاده بطيبة المرضيه","b":"وأمه مارية القبطيه"},
{"n":"140","a":"كانت لخير مرسل سرية","b":"صلى عليه خالق البريه"},
{"n":"141","a":"وكلهم قبل البلوغ ماتوا","b":"حياته كما روى الثقات"},
{"n":"142","a":"أما بناته فأربع بلا","b":"خلف وفي الكبرى خلاف نقلا"},
{"n":"143","a":"أصحه زينب ثم اختلفوا","b":"فيها مع القاسم فيما وصفوا"},
{"n":"144","a":"فقال قوم هي منه أكبر","b":"وقال قوم آخرون أصغر"},
{"n":"145","a":"ورتب الثلاث في الميلاد","b":"(رأف) وأسلمنا بلا عناد"},
{"n":"146","a":"وفي ثلاثين لعام الفيل","b":"قد ولدت زينب للرسول"},
{"n":"147","a":"وابن الربيع انكحت فلما","b":"أرسل خير مرسل ألما"},
{"n":"148","a":"به قريش في فراق زينبا","b":"فلم يجبهم للفراق بل أبى"},
{"n":"149","a":"وأسلمت وهاجرت وهاجرا","b":"من بعدها فردها خير الورى"},
{"n":"150","a":"إليه بالعقد الذي قد سبقا","b":"على الأصح لا بثان لحقا"},
{"n":"151","a":"وولدت أمامة عليا","b":"له ومات عام(ح) وفيا"},
{"n":"152","a":"وأنكحت رقية عتيبه","b":"وأم كلثوم أخاه عتبه"},
{"n":"153","a":"فطلقاهما معا إذ نزلا","b":"تبت فتبا لهما إذ فعلا"},
{"n":"154","a":"ثم تزوج ابن عفان الرضى","b":"رقية أتت بنجل فقضى"},
{"n":"155","a":"وهو عام ست بعد موت الأم","b":"في سنة اثنين بغير وهم"},
{"n":"156","a":"وأنكح الأخرى بدون مين","b":"ومن هنا لقب ذا النورين"},
{"n":"157","a":"ولم تلد له وعام تسع","b":"توفيت كما أتى في السمع"},
{"n":"158","a":"وبنت خير المرسلين الصغرى","b":"اسما نساء العالمين قدرا"},
{"n":"159","a":"مولدها في عام (آم) كانا","b":"من مقدم الفيل ولما بانا"},
{"n":"160","a":"لها من الأعوام خمسة عشر","b":"زوجها حيدرة خير البشر"},
{"n":"161","a":"فولدت له من الأولاد","b":"بنتين وابنين بلا عناد"},
{"n":"162","a":"الحسن الحسين ثم زينب","b":"وأم كلثوم إليهم تنسب"},
{"n":"163","a":"وولدت رقية ومحسنا","b":"أيضا وماتا في الصبا ودفنا"},
{"n":"164","a":"ثم ابن جعفر بنا بزينب","b":"وولدت له عليا وحبي"},
{"n":"165","a":"بأختها الفاروق حتى ولدت","b":"زيدا له وبعده تزوجت"},
{"n":"166","a":"محمد بن جعفر وإذ مضى","b":"تزوجت عونا أخاه وقضى"},
{"n":"167","a":"فنكحت أخاه عبدالله","b":"وعنده ماتت بلا اشتباه"},
{"n":"168","a":"مع ابنها زيد بوقت واحد","b":"وكان فيه سنن للناقد"},
{"n":"169","a":"وبعد موت المصطفى بأشهر","b":"ثلاثة أو ستة في الأشهر"},
{"n":"170","a":"توفيت بنت الحبيب المجتبا","b":"فاطمة أم الكرام النجبا"},
{"n":"171","a":"بيان أعمام النبي المصطفى","b":"وذكر عمات الحبيب المقتفى"},
{"n":"172","a":"أعمامه اثنان وعشرة تعد","b":"وقيل تسعة وعشرة ورد"},
{"n":"173","a":"الحارث الزبير والمقوم","b":"وعبد كعبة ضرار قثم"},
{"n":"174","a":"كذا المغيرة مع الغيداق","b":"لم يدركوا الإسلام باتفاق"},
{"n":"175","a":"وحمزة العباس عند العلما","b":"قد أدركا البعثة ثم أسلما"},
{"n":"176","a":"لكن أبو طالب مع أبي لهب","b":"قد أدركا البعث وما نالا الأرب"},
{"n":"177","a":"عماته صفية المبره","b":"أميمة عاتكة وبره"},
{"n":"178","a":"وهكذا أم حكيم أروى","b":"وعنهم إسلام الأولى يروى"},
{"n":"179","a":"بيان ماله من الموالي","b":"والخدم الأحرار باحتفال"},
{"n":"180","a":"زيد أسامة ابنه ثوبان","b":"أنسة فضالة شقران"},
{"n":"181","a":"ثم رباح ويسار وارد","b":"طهمان مأبور عبيد واقد"},
{"n":"182","a":"وأبواهما ورافع هشام","b":"حنين أحمر سليم ذو اهتمام"},
{"n":"183","a":"كركرة النوبي زيد أسلم","b":"سفينة أنجشة ومدعم"},
{"n":"184","a":"أبو لبابة أبو هند أبو","b":"ضمرة والإماء حين تحسب"},
{"n":"185","a":"مارية سلمى وأم رافع","b":"بركة كانت لخير شافع"},
{"n":"186","a":"حاضنة ميمونة ريحانه","b":"خضرة رضوى فعو حسبانه"},
{"n":"187","a":"وكان من خدامه الأحرار","b":"أنس بن مالك الأنصاري"},
{"n":"188","a":"ثم ابن مسعود بلال وأبو","b":"ذر ربيعة بن كعب حسبوا"},
{"n":"189","a":"وعقبة بن عامر وسعد","b":"ذو مخمر أسماء ثم هند"},
{"n":"190","a":"بيان حراس النبي المصطفى","b":"صلى عليه ربنا وشرفا"},
{"n":"191","a":"حرسه في يوم بدر سعد","b":"فتى معاذ وامرآن بعد"},
{"n":"192","a":"في أحد محمد ذكوان","b":"عليهما الرحمة والرضوان"},
{"n":"193","a":"والحارس الزبير يوم الخندق","b":"وابن أبي وقاص خير مشفق"},
{"n":"194","a":"ثم أبو أيوب وابن بشر","b":"في خيبر المشهود دون نكر"},
{"n":"195","a":"قد حرسوه ثم في وادي القرى","b":"كان بلال حارسا بلا امترا"},
{"n":"196","a":"وترك الحراس لما أخبرا","b":"بعصمة الله له خير الورى"},
{"n":"197","a":"وكان حاديا له البراء","b":"أنجشة جاءت بذا الأنباء"},
{"n":"198","a":"صلى عليه ربنا وسلما","b":"والآل والأصحاب خير من سما"},
{"n":"199","a":"بيان رسل المصطفى لمن ملك","b":"صلى عليه الله ما دار الفلك"},
{"n":"200","a":"إلى النجاشي النبي أرسلا","b":"عمرا فبجل الكتاب وتلا"},
{"n":"201","a":"ومات مسلما وصلى المصطفى","b":"عليه مع أصحابه أولي الصفا"},
{"n":"202","a":"ودحية إلى هرقل أرسلا","b":"فشح ثم ابن حذافة إلى"},
{"n":"203","a":"كسرى فمزق الكتاب مزقا","b":"وحاطبا إلى المقوقس ارتقا"},
{"n":"204","a":"فقارب الإسلام حتى أهدى","b":"جاريتين دلدلا وعبدا"},
{"n":"205","a":"ثم إلى من ملكا عمانا","b":"عمرا فأسلما له ودانا"},
{"n":"206","a":"ولليمامة سليطا أرسلا","b":"فلم يفز صاحبها إذ سألا"},
{"n":"207","a":"من النبي جعل بعض الأمر له","b":"ثم إلى البلقا شجاعا أرسله"},
{"n":"208","a":"وأرسل العلا إلى البحرين","b":"فأسلم المنذر دون مين"},
{"n":"209","a":"والأشعري ومعاذا لليمن","b":"فأسلموا دون قتال وفتن"},
{"n":"210","a":"بيان من كان من الكتاب له","b":"صلى عليه ربنا وفضله"},
{"n":"211","a":"زيد أبي والزبير والعلا","b":"والخالدان الخلفاء الفضلا"},
{"n":"212","a":"وثابت وعامر وعمرو","b":"عمار سلمان بلال الصدر"},
{"n":"213","a":"وابن أبي سفيان مع أبان","b":"وابن الربيع فاستمع بياني"},
{"n":"214","a":"ثم ابن مسعود أخو الوداد","b":"وحمزة منهم مع المقداد"},
{"n":"215","a":"وكان ممن يضرب الأعناقا","b":"بين يديه إن رأى شقاقا"},
{"n":"216","a":"علي والزبير وابن مسلمه","b":"وعاصم بن ثابت لتعلمه"},
{"n":"217","a":"ثم ابن سفيان مع المقداد","b":"أصحاب ما اختار من العباد"},
{"n":"217","a":"بيان من يقطع بالجنان","b":"لهم ومن أذن للعدنان"},
{"n":"218","a":"يقطع بالجنة والإكرام","b":"لعشرة للخلفا الأعلام"},
{"n":"219","a":"وللزبير وابن عوف وسعيد","b":"وعامر سعد وطلحة السعيد"},
{"n":"220","a":"وعمرو أوس وبلال سعد","b":"زياد المؤذنون عدوا"},
{"n":"221","a":"رضوان ربنا عليهم طرا","b":"ومن تلا منهاجهم وبرا"},
{"n":"222","a":"ذكر دوابه عليه أفضل","b":"صلاة ربي دائما وأكمل"},
{"n":"223","a":"له من الخيل العتاق عشره","b":"أو سبعة كما حكاه المهره"},
{"n":"224","a":"أولها السكب المحجل الأغر","b":"الطلق ذو السبق الذي به اشتهر"},
{"n":"225","a":"أول ما غزا عليه المجتبا","b":"بأحد فلم يزل مهذبا"},
{"n":"226","a":"والورد والمرتجز الذي شهد","b":"له به خزيمة حين جحد"},
{"n":"227","a":"والطرف واللحيف والملاوح","b":"والضرس واللزاز ذاك السابح"},
{"n":"228","a":"ثم البغال كلها مرويه","b":"فضة والدلدل والإيليه"},
{"n":"229","a":"ثم حمار اسمه يعفور","b":"والناقة القصوى فقط مأثور"},
{"n":"230","a":"وهي التي امتطى بلا امتراء","b":"نبينا في الهجرة الغراء"},
{"n":"231","a":"وكان لا يحمله إن نزلا","b":"عليه وحي غيرها ونقلا"},
{"n":"232","a":"أن اسمها الجدعاء والعضباء","b":"فقد ترادفت لها الأسماء"},
{"n":"233","a":"ومائة كانت له من الغنم","b":"ومعها عشرون لقحة تلم"},
{"n":"234","a":"وكان يختص بشرب شاة","b":"تدعى بغيثة لدى الرواة"},
{"n":"235","a":"وديكه الأبيض جاء في الخبر","b":"ولم يجىء فيه اقتناؤه البقر"},
{"n":"236","a":"بيان ماله من السلاح","b":"صلى عليه واهب الفلاح"},
{"n":"237","a":"له من الأسياف تسعة فقط","b":"اسماؤها مروية عن من فرط"},
{"n":"238","a":"منها الذي أصابه من بدر","b":"وكان يدعى ذا الفقار فادر"},
{"n":"239","a":"ومثله القلعي والبتار","b":"والحتف قد جاءت به الأخبار"},
{"n":"240","a":"كذلك المخذم والقضيب","b":"والعضب والرسوب يالبيب"},
{"n":"241","a":"وكان عنده من الرماح","b":"أربعة تعد للكفاح"},
{"n":"242","a":"ومثلها قسيه في العد","b":"والترس والجعبة فيما أبدي"},
{"n":"243","a":"وأدرع كانت له بهيه","b":"أسماؤها فضة والسغديه"},
{"n":"244","a":"ثالثها ذات الفضول تدعى","b":"كانت له يوم حنين درعا"},
{"n":"245","a":"ومغفر يدعى السبوغ كان له","b":"ونحوه منطقة مجمله"},
{"n":"246","a":"وراية سوداء بالعقاب","b":"تدعى هداك الله للصواب"},
{"n":"247","a":"وكان أيضا عنده لواء","b":"أبيض قد فشت بذا الأنباء"},
{"n":"248","a":"بيان ماله من الثياب","b":"ومن أثاث فاستمع خطابي"},
{"n":"249","a":"كان له من الثياب اثنا عشر","b":"على الذي نقله أهل السير"},
{"n":"250","a":"منها قميصان له شعار","b":"ثم كساءان له دثار"},
{"n":"251","a":"وجبتان وإزار وثياب","b":"أربعة ثم العمامة السحاب"},
{"n":"252","a":"أعني التي وهبها عليا","b":"فلا تكن بعلمها غبيا"},
{"n":"253","a":"ثم قلانس صغار لاطيه","b":"وهي ثلاث فاغتنم بيانيه"},
{"n":"254","a":"والمشط من عاج له والمكحله","b":"مرآته المقراض والسواك له"},
{"n":"255","a":"ثم فراش أدم قد حشيا","b":"بالليف ثم قدحان فعيا"},
{"n":"256","a":"فواحد بفضة مضبب","b":"والتور من حجارة ومخضب"},
{"n":"257","a":"ومن زجاج قدح ومغتسل","b":"له من الصفر وقصعة تمل"},
{"n":"258","a":"والصاع والسرير ثم المد","b":"وخاتم من فضة يعد"},
{"n":"259","a":"وكان قد أهدى له خفين","b":"أصحمة أيضا بدون مين"},
{"n":"260","a":"وكان ثوبان له للجمعه","b":"غير ثياب لبسه المرتفعه"},
{"n":"261","a":"وكان منديل له ليمسحا","b":"به على الوجه المنير الأصبحا"},
{"n":"262","a":"صلى عليه ربنا وسلما","b":"وآله وصحبه وكرما"},
{"n":"263","a":"بيان بعض معجزات المصطفى","b":"صلى عليه ربنا وشرفا"},
{"n":"264","a":"منها القرآن المعجز الذي بهر","b":"إعجازه كل العقول وقهر"},
{"n":"265","a":"فلم يجىء بمثله ولن يجي","b":"إنس ولا جن وكم من مزعج"},
{"n":"266","a":"لهم مقرع على الإتيان","b":"به وهم فرسان هذا الشان"},
{"n":"267","a":"قد امتطوا منه جواد السبق","b":"واحرزوا عنانه في النطق"},
{"n":"268","a":"بل أخرسوا وهم ألد اللدد","b":"إلا عن الدعوى ومحض الجحد"},
{"n":"269","a":"فعند ذاك أمر القرآن","b":"أن تضرب الأعناق والبنان"},
{"n":"270","a":"لله ما حواه من عجائب","b":"جلت عن الحصر ومن غرائب"},
{"n":"271","a":"لو لم يجئ بآية سواه","b":"صلى عليه ربنا كفاه"},
{"n":"272","a":"لكنه أتى بما أعيى البشر","b":"من معجزات بينات كالقمر"},
{"n":"273","a":"وغسل قلبه وشق الصدر","b":"وحشوه بسر أي سر"},
{"n":"274","a":"وجيء بالبراق للإسراء","b":"به إلى الأقصى من السماء"},
{"n":"275","a":"بل لم يزل يرقى إلى أن نالا","b":"منزلة جلت فلن تنالا"},
{"n":"276","a":"حباه ذو العزة بالمقام","b":"فيها وبالرؤية والكلام"},
{"n":"277","a":"وفرض الخمسين ثم خففا","b":"عنا به لخمسة وضعفا"},
{"n":"278","a":"ثوابها إذ كثر الأمدادا","b":"تفضلا وقلل الأعدادا"},
{"n":"279","a":"وأم خير مرسل للرسل","b":"وعاد من بعد انقضاء الليل"},
{"n":"280","a":"فأخبر الناس بما قد أطلع","b":"عليه في مسراه لما أن رجع"},
{"n":"281","a":"فمن سعيد مؤمن بما ذكر","b":"ومن شقي خاسر به كفر"},
{"n":"282","a":"والشمس بالصهباء للمختار","b":"ردت ويوم العير في الأخبار"},
{"n":"283","a":"وإذ أتى الفجار نحو الباب","b":"لقتله فقام بالتراب"},
{"n":"284","a":"وذره على رؤوس القوم","b":"فسقطت أذقانهم بالنوم"},
{"n":"285","a":"وقال شاهت الوجوه ودعا","b":"فمن أجابه ببدر صرعا"},
{"n":"286","a":"وفي حنين إذ رمى الأقواما","b":"بقبضة فانهزموا انهزاما"},
{"n":"287","a":"وفي حمام الغار والعناكب","b":"حاكت وباضت أبدع العجائب"},
{"n":"288","a":"وإذ رأى سراقة الهلاكا","b":"بك استغاث فنجا هناكا"},
{"n":"289","a":"ودرت الألبان إذ مسحتا","b":"على ضروع من شياه شتى"},
{"n":"290","a":"كشاة عبدالله والمقداد","b":"وأم معبد من الأفراد"},
{"n":"291","a":"وكم من الأعيان قلبها انجلى","b":"بلمس يمناك بمشهد الملا"},
{"n":"292","a":"كآية العرجون إذ أضاء","b":"لولد النعمان في سوداء"},
{"n":"293","a":"مطيرة عشوا إلى أن ولجا","b":"فضرب الشيطان حتى خرجا"},
{"n":"294","a":"وإذ دفعت لابن جحش بأحد","b":"عسيب نخل فغدا سيفا يجد"},
{"n":"295","a":"والجذل لابن محصن ببدر","b":"دفعته فعاد سيفا يفري"},
{"n":"296","a":"ولم يزل لديه حتى استشهدا","b":"عونا به يضرب أعناق العدا"},
{"n":"297","a":"والماء قد زودت قوما رفدا","b":"فعاد أيضا لبنا وزبدا"},
{"n":"298","a":"وأخبرتك الشاة بعد الشي","b":"بأنها سمت فداك حيي"},
{"n":"299","a":"والطفل في المهد بتصديقك يا","b":"أزكى الورى قد فاه فيما رويا"},
{"n":"300","a":"وكم جمادات وعجماوات","b":"فاهت بتصديقك في آيات"},
{"n":"301","a":"وقبضة التمر التي قد أطعما","b":"منها جميع الجيش وهي نحو ما"},
{"n":"302","a":"كانت بل أربى منه بل قد أنفقا","b":"من ذلك التمر ابن صخر أوسقا"},
{"n":"303","a":"ولم يزل لديه حتى نهبا","b":"مقتل ذي النورين فيما نهبا"},
{"n":"304","a":"وكم من القليل قد كثرتا","b":"زكم من الأموات قد أحييتا"},
{"n":"305","a":"وكم من الأشجار قد دعوتا","b":"أتت مطيعة لما أمرتا"},
{"n":"306","a":"والجذع قد حن حنين الثكلى","b":"إليك حتى نال منك وصلا"},
{"n":"307","a":"لو لم ينله لم يزل كئيبا","b":"عليك ما لاح سنا غريبا"},
{"n":"308","a":"وكم عمى وعمه أذهبتا","b":"عن أعين وعن قلوب حتى"},
{"n":"309","a":"أدركت الأبصار والبصائر","b":"ما لم تكن تظنه الضمائر"},
{"n":"310","a":"وكم من الأدواء قد أبرأتا","b":"في الحال بالراحة إذ لمستا"},
{"n":"311","a":"بل فار منها الماء لما ضمئوا","b":"حتى ارتوى الأصحاب بل توضئوا"},
{"n":"312","a":"ومطروا سبتا إذ استسقيتا","b":"بها وأقلعت إذا استصحيتا"},
{"n":"313","a":"ومن عليه أو له دعوتا","b":"أصاب في الحالين ما سألتا"},
{"n":"314","a":"وكم من الغيوب قد نبأتا","b":"به فلم تعد الذي ذكرتا"},
{"n":"315","a":"فكل ذي علم وذي عرفان","b":"منك استمده سوى الرحمن"},
{"n":"316","a":"هذا وكم من آية لا تحصى","b":"عدا منحتها ولا تستقصى"},
{"n":"317","a":"فالحمد لله الذي أعطاكا","b":"مالم ينله أحد سواكا"},
{"n":"318","a":"ذكر وفاته صلاة ربه","b":"عليه ثم آله وصحبه"},
{"n":"319","a":"توفي المختار عام (أي)","b":"وعمره (صج) على المرضي"},
{"n":"320","a":"وقت الضحى في مثل يوم ولدا","b":"فيه عليه الله صلى أبدا"},
{"n":"321","a":"وخير المختار في البقاء","b":"في هذه الدار وفي اللقاء"},
{"n":"322","a":"لربه فاختار أن يلقاه","b":"صلى عليه الله ما أرقاه"},
{"n":"323","a":"ومدة السقم (يد) وقد دفن","b":"ليلة الاربعاء خير من أمن"},
{"n":"324","a":"ودهش الأصحاب إذ مات النبي","b":"ولم يكن أثبت فيهم من أبي"},
{"n":"325","a":"بكر وعمه الرضى العباس","b":"فخطب الصديق خير الناس"},
{"n":"326","a":"وثبت القوم وجاء الخضر","b":"معزيا لهم على ما أثروا"},
{"n":"327","a":"وغسل المختار في الثياب","b":"وولي الغسل من الأصحاب"},
{"n":"328","a":"علي والعباس ثم ابناه","b":"قثم والفضل ومولياه"},
{"n":"329","a":"شقران مع أسامة وذكرا","b":"أن ابن خولي معهم قد حضرا"},
{"n":"330","a":"وكفن المختار في أثواب","b":"ثلاثة بيض بلا ارتياب"},
{"n":"331","a":"دون عمامة ولا قميص","b":"ولا خياطة على المنصوص"},
{"n":"332","a":"بل جعلت لفائفا وأدرجا","b":"فيها عليه الله صلى مدرجا"},
{"n":"333","a":"وفرشت للمصطفى في القبر","b":"قطيفة حمراء دون نكر"},
{"n":"334","a":"وكان في طيبة حافران","b":"ذو الشق واللحد فجاء الثاني"},
{"n":"335","a":"وألحد القبر له وأطبقا","b":"عليه تسع لبنات مطبقا"},
{"n":"336","a":"في بيت عائشة والصديق","b":"يليه ثم حوله الفاروق"},
{"n":"337","a":"صلى عليه ربنا وسلما","b":"والآل والأصحاب أنجم السما"},
{"n":"338","a":"قد تم نظم قرة الأبصار","b":"بحول هاد ماجد غفار"},
{"n":"339","a":"في غرة الشهر الأغر مولد","b":"اسمى الورى نبينا محمد"},
{"n":"340","a":"بطيبة الغراء دار المصطفى","b":"صلى عليه ربنا وشرفا"},
{"n":"341","a":"وآله وصحبه ومن تلا","b":"منهاجه من الأنام مسجلا"}]