[null,null,"﴿بَاخِعٌ﴾: مُهْلِكٌ.",null,"﴿مُحْدَثٍ﴾: حَدِيثِ النُّزُولِ.",null,"﴿زَوْجٍ كَرِيمٍ﴾: نَوْعٍ حَسَنٍ نافِعٍ.",null,null,null,null,null,null,null,null,null,null,null,null,"﴿الضَّالِّينَ﴾: الجاهِلِينَ، وذَلِكَ قَبْلَ أنْ يُوحى إليَّ.","﴿حُكْمًا﴾: النُّبُوَّةَ.","﴿عَبَّدتَّ﴾: جَعَلْتَهُمْ عَبِيدًا.",null,null,null,null,null,null,null,null,null,null,"﴿وَنَزَعَ يَدَهُ﴾: أخْرَجَها مِن جَيْبِهِ.",null,null,"﴿أَرْجِهِ﴾: أخِّرْهُ.\n\n﴿حَاشِرِينَ﴾: جُنُودًا يَجْمَعُونَ السَّحَرَةَ.",null,null,null,null,null,null,null,"﴿بِعِزَّةِ فِرْعَوْنَ﴾: أقْسَمُوا بِعِزَّتِهِ، وقُوَّتِهِ.","﴿تَلْقَفُ﴾: تَبْتَلِعُ بِسُرْعَةٍ.\n\n﴿مَا يَافِكُونَ﴾: ما يَفْعَلُونَهُ مِنَ الكَذِبِ والتَّزْوِيرِ.",null,null,null,"﴿مِّنْ خِلَافٍ﴾: بِقَطْعِ اليَدِ اليُمْنى والرِّجْلِ اليُسْرى، أوْ عَكْسَ ذَلِكَ.","﴿لَا ضَيْرَ﴾: لا ضَرَرَ.\n\n﴿مُنقَلِبُونَ﴾: راجِعُونَ.",null,null,"﴿حَاشِرِينَ﴾: جامِعِينَ لِلْجَيْشِ مِنَ المَدائِنِ.","﴿لَشِرْذِمَةٌ﴾: لَطائِفَةٌ حَقِيرَةٌ.",null,null,null,"﴿وَكُنُوزٍ﴾: خَزائِنِ الأَمْوالِ.\n\n﴿وَمَقَامٍ كَرِيمٍ﴾: مَنازِلَ حِسانٍ.",null,"﴿مُّشْرِقِينَ﴾: وقْتَ شُرُوقِ الشَّمْسِ.","﴿تَرَاءَى الْجَمْعَانِ﴾: رَأى كُلُّ فَرِيقٍ الآخَرَ.",null,"﴿فِرْقٍ﴾: قِطْعَةٍ مِنَ البَحْرِ.\n\n﴿كَالطَّوْدِ﴾: كالجَبَلِ.","﴿وَأَزْلَفْنَا ثَمَّ الْآخَرِينَ﴾: قَرَّبْنا هُناكَ، فِرَعْوَنَ، وقَوْمَهُ.",null,null,null,null,null,null,"﴿عَاكِفِينَ﴾: مُقِيمِينَ عَلى عِبادَتِها.",null,null,null,"﴿أَفَرَأَيْتُم﴾: أبْصَرْتُمْ بِتَدَبُّرٍ.",null,null,null,null,null,null,null,"﴿حُكْمًا﴾: عِلْمًا وفَهْمًا.","﴿لِسَانَ صِدْقٍ﴾: ثَناءً حَسَنًا.\n\n﴿الْآخِرِينَ﴾: مَن ياتُونَ بَعْدِي إلى يَوْمِ القِيامَةِ.",null,null,null,null,"﴿سَلِيمٍ﴾: سالِمٍ مِنَ الشِّرْكِ والنِّفاقِ والضَّغِينَةِ.","﴿وَأُزْلِفَتِ﴾: قُرِّبَتْ.","﴿وَبُرِّزَتِ﴾: أُظْهِرَتْ.",null,null,"﴿فَكُبْكِبُوا﴾: فَجُمِعُوا، وأُلْقُوا.",null,null,null,null,null,null,"﴿حَمِيمٍ﴾: مُشْفِقٍ يَهْتَمُّ بِأَمْرِنا.","﴿كَرَّةً﴾: رَجْعَةً إلى الدُّنْيا.",null,null,null,null,null,null,null,null,"﴿الْأَرْذَلُونَ﴾: السَّفَلَةُ مِنَ النّاسِ.",null,null,null,null,"﴿الْمَرْجُومِينَ﴾: المَقْتُولِينَ رَمْيًا بِالحِجارَةِ.",null,"﴿فَافْتَحْ﴾: احْكُمْ.","﴿الْمَشْحُونِ﴾: المَمْلُوءِ بِالنّاسِ، والدَّوابِّ، والمَتاعِ.",null,null,null,null,null,null,null,null,"﴿رِيعٍ﴾: مَكانٍ مُرْتَفِعٍ.\n\n﴿آيَةً﴾: بِناءً عالِيًا.\n\n﴿تَعْبَثُونَ﴾: تُشْرِفُونَ مِنهُ فَتَسْخَرُونَ مِنَ المارَّةِ.","﴿مَصَانِعَ﴾: قُصُورًا مَنِيعَةً وحُصُونًا مُشَيَّدَةً.",null,null,"﴿أَمَدَّكُم﴾: أعْطاكُمْ وأَنْعَمَ عَلَيْكُمْ.",null,null,null,"﴿سَوَاءٌ عَلَيْنَا﴾: يَسْتَوِي عِنْدَنا.\n\n﴿أَوَعَظْتَ﴾: أخَوَّفْتَ.","﴿خُلُقُ﴾: دِينُ، وعادَةُ.",null,null,null,null,null,null,null,null,null,null,"﴿طَلْعُهَا هَضِيمٌ﴾: ثَمَرُها يانِعٌ لَيِّنٌ نَضِيجٌ.","﴿فَارِهِينَ﴾: ماهِرِينَ بِنَحْتِها أشِرِينَ بَطِرِينَ.",null,"﴿الْمُسْرِفِينَ﴾: المُتَمادِينَ فيِ مَعْصِيَةِ اللهِ.",null,"﴿الْمُسَحَّرِينَ﴾: المَغْلُوبِ عَلى عُقُولِهِمْ بِكَثْرَةِ السِّحْرِ.",null,"﴿شِرْبُ﴾: نَصِيبٌ مِنَ الماءِ.",null,"﴿فَعَقَرُوهَا﴾: نَحَرُوها.",null,null,null,null,null,null,null,null,"﴿عَادُونَ﴾: مُتَجاوِزُونَ ما أباحَهُ اللهُ لَكُمْ مِنَ الحَلالِ إلى الحَرامِ.","﴿الْمُخْرَجِينَ﴾: المَطْرُودِينَ مِن بِلادِنا.","﴿الْقَالِينَ﴾: المُبْغِضِينَ لِعَمَلِكُمْ بُغْضًا شَدِيدًا.",null,null,"﴿الْغَابِرِينَ﴾: الباقِينَ فيِ العَذابِ.",null,"﴿فَسَاءَ﴾: قَبُحَ.",null,null,"﴿أَصْحَابُ الْأَيْكَةِ﴾: أصْحابُ الأَرْضِ ذاتِ الشَّجَرِ المُلْتَفِّ، وهُمْ قَوْمُ شُعَيْبٍ.",null,null,null,null,"﴿الْمُخْسِرِينَ﴾: النّاقِصِينَ لِحُقُوقِ النّاسِ.","﴿بِالْقِسْطَاسِ﴾: بِالمِيزانِ.\n\n﴿الْمُسْتَقِيمِ﴾: العَدْلِ السَّوِيِّ.","﴿وَلَا تَبْخَسُوا﴾: لا تَنْقُصُوا.\n\n﴿وَلَا تَعْثَوْا﴾: لا تُكْثِرُوا الفَسادَ.","﴿وَالْجِبِلَّةَ الْأَوَّلِينَ﴾: الخَلِيقَةَ والأُمَمَ الماضِينَ.","﴿الْمُسَحَّرِينَ﴾: مَن أصابَهُمْ سِحْرٌ شَدِيدٌ، فَذَهَبَ بِعُقُولِهِمْ.",null,"﴿كِسَفًا﴾: قِطَعًا مِنَ العَذابِ.",null,"﴿الظُّلَّةِ﴾: سَحابَةٍ أظَلَّتْهُمْ وجَدُوا تَحْتَها بَرْدًا، فَلمّا اجْتَمَعُوا أحْرَقَتْهُمْ بِنارِها.",null,null,null,"﴿الرُّوحُ الْأَمِينُ﴾: جِبْرِيلُ عليه السلام.",null,null,"﴿زُبُرِ الْأَوَّلِينَ﴾: كُتُبِ الأَنْبِياءِ السّابِقِينَ.","﴿آيَةً﴾: عَلامَةً عَلى صِحَّةِ نُبُوَّتِكَ.","﴿الْأَعْجَمِينَ﴾: الَّذِينَ لا يَتَكَلَّمُونَ العَرَبِيَّةَ.",null,"﴿سَلَكْنَاهُ﴾: أدْخَلْنا التَّكْذِيبَ.",null,"﴿بَغْتَةً﴾: فَجْأَةً.","﴿مُنظَرُونَ﴾: مُمْهَلُونَ مُؤَخَّرُونَ.",null,"﴿أَفَرَأَيْتَ﴾: أفَعَلِمْتَ؟",null,null,null,null,null,null,"﴿السَّمْعِ﴾: اسْتِماعِ القُرْآنِ مِنَ السَّماءِ.\n\n﴿لَمَعْزُولُونَ﴾: لَمَحْجُوبُونَ مَرْجُومُونَ بِالشُّهُبِ.",null,null,"﴿وَاخْفِضْ جَنَاحَكَ﴾: ألِنْ جانِبَكَ وكَلامَكَ تَواضُعًا.",null,null,"﴿حِينَ تَقُومُ﴾: تُصَلِّي اللَّيْلَ وحْدَكَ.",null,null,null,"﴿أَفَّاكٍ﴾: كَذّابٍ.\n\n﴿أَثِيمٍ﴾: كَثِيرِ الآثامِ.","﴿يُلْقُونَ السَّمْعَ﴾: تُلْقِي الشَّياطِينُ إلى الكُهّانِ ما يَسْتَرِقُونَ مِنَ المَلَأِ الأَعْلى.",null,"﴿وَادٍ﴾: فَنٍّ مِن فُنُونِ الباطِلِ، والكَذِبِ.\n\n﴿يَهِيمُونَ﴾: يَخُوضُونَ.",null,"﴿مُنقَلَبٍ﴾: مَرْجِعٍ."]