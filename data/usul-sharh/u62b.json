{"u62b_1":{"title":"الحواشي","foot":"","secs":[{"src":"حواشي الكتاب","ref":"ص ١٥١","url":"","text":"في ميزان الأصول، ٢: ٦٩٨.\n\nفي أصول البزدوي، ٣: ٢١٧."}]},"u62b_2":{"title":"الحواشي","foot":"","secs":[{"src":"حواشي الكتاب","ref":"ص ١٥١","url":"","text":"ينظر: ميزان الأصول ٢: ٦٩٧-٧٠٥، والفصول في الأصول ٣: ٣٥٨-٣٦٦، والأصول وشرحه كشف الأسرار ٣: ٢١٧-٢١٨."}]},"u62b_3":{"title":"الحواشي","foot":"","secs":[{"src":"حواشي الكتاب","ref":"ص ١٥١","url":"","text":"ينظر: المنار ونور الأنوار ٢: ١٠٠-١٠٢، ودراسات في أصول الحديث ٤٥١-٤٥٤."}]},"u62b_4":{"title":"الحواشي","foot":"","secs":[{"src":"حواشي الكتاب","ref":"ص ١٥٢","url":"","text":"ينظر: فتح العلي المالك ١: ٨٩-١٠١، والموافقات ٤: ٧٨."}]},"u62b_5":{"title":"الحواشي","foot":"","secs":[{"src":"حواشي الكتاب","ref":"ص ١٥٢","url":"","text":"الأحاديث المختارة ١: ٢٣٩، وقال: إسناده صحيح، وسنن الدَّارمي ١: ٧١، ومصنف ابن أبي شيبة ٤: ٥٤٣، والسنن الكبير ١٠: ١١٠، وغيرها.\n\nينظر: الاعتصام ١: ٥٣١.\n\nالسنن الكبير ١٠: ١١٥."}]},"u62b_7":{"title":"الحواشي","foot":"","secs":[{"src":"حواشي الكتاب","ref":"ص ١٥٢","url":"","text":"مسند أحمد ٦: ٩١، وصححه الأرنؤوط، والأدب المفرد ص١١٥."}]},"u62b_8":{"title":"الحواشي","foot":"","secs":[{"src":"حواشي الكتاب","ref":"ص ١٥٣","url":"","text":"ينظر: أثر الحديث الشريف ص٦٤."}]},"u62b_9":{"title":"الحواشي","foot":"","secs":[{"src":"حواشي الكتاب","ref":"ص ١٥٣","url":"","text":"ينظر: ترتيب المدارك وتقريب المسالك ١: ١١."}]},"u62b_10":{"title":"الحواشي","foot":"","secs":[{"src":"حواشي الكتاب","ref":"ص ١٥٣","url":"","text":"صحيح مسلم ٢: ٧٨٥.\n\nالمعجم الأوسط ١: ١٧٥، واللفظ له، ومصنف ابن أبي شيبة ٢٠: ٤٨٨."}]},"u62b_11":{"title":"الحواشي","foot":"","secs":[{"src":"حواشي الكتاب","ref":"ص ١٥٣","url":"","text":"ينظر: جامع بيان العلم ر١١٨٢."}]},"u62b_12":{"title":"الحواشي","foot":"","secs":[{"src":"حواشي الكتاب","ref":"ص ١٥٣","url":"","text":"ينظر: المدخل لابن الحاج ١: ١٢٩، وفتح العلي المالك ١: ٩٠."}]},"u62b_13":{"title":"الحواشي","foot":"","secs":[{"src":"حواشي الكتاب","ref":"ص ١٥٤","url":"","text":"ينظر: أثر الحديث الشَّريف ص٦٣."}]}}