{"u51_6":{"title":"الحواشي","foot":"","secs":[{"src":"حواشي الكتاب","ref":"ص ١٢٢","url":"","text":"في المستدرك ١: ٥٥٣، وسنن البيهقي الكبير ٤: ١٠٥، ومُصَنَّف عبد الرَّزاق ٤: ١٨، وشرح معاني الآثار ٢: ٢٧، وغيرها."}]},"u51_11":{"title":"الحواشي","foot":"","secs":[{"src":"حواشي الكتاب","ref":"ص ١٢٣","url":"","text":"ينظر: روضة الناظر٢: ١٣٧، والمستصفى١: ٢٧٠."}]},"u51_13":{"title":"الحواشي","foot":"","secs":[{"src":"حواشي الكتاب","ref":"ص ١٢٣","url":"","text":"ينظر: تفصيل ما سبق شرح رسم المفتي ١: ٤١-٤٤، وأصول الإفتاء ص٤٠-٤٢، وغيرهما."}]},"u51_15":{"title":"الحواشي","foot":"","secs":[{"src":"حواشي الكتاب","ref":"ص ١٢٣","url":"","text":"ينظر: أصول الإفتاء ص٤٢-٤٣، وغيره."}]}}